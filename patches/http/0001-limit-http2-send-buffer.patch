diff --git a/downstreamtests/send_buffer_test.go b/downstreamtests/send_buffer_test.go
new file mode 100644
--- /dev/null
+++ b/downstreamtests/send_buffer_test.go
@@ -0,0 +1,124 @@
+package downstreamtests
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/http"
+	"github.com/metacubex/http/http2"
+	"github.com/metacubex/tls"
+)
+
+type measuredBody struct {
+	*bytes.Reader
+	maxRead atomic.Int64
+}
+
+func (b *measuredBody) Read(p []byte) (int, error) {
+	for old := b.maxRead.Load(); int64(len(p)) > old; old = b.maxRead.Load() {
+		if b.maxRead.CompareAndSwap(old, int64(len(p))) {
+			break
+		}
+	}
+	return b.Reader.Read(p)
+}
+
+// Exercise both HTTP/2 clients against a peer advertising large frames.
+// Measuring actual body reads catches a missed copy of the bundled implementation.
+func TestHTTP2RequestBodyBuffer(t *testing.T) {
+	for _, standalone := range []bool{false, true} {
+		for _, frameSize := range []uint32{16 << 10, 1 << 20} {
+			t.Run(fmt.Sprintf("standalone=%t/frame=%d", standalone, frameSize), func(t *testing.T) {
+				ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+				defer cancel()
+				clientConn, serverConn := net.Pipe()
+				deadline, _ := ctx.Deadline()
+				clientConn.SetDeadline(deadline)
+				serverConn.SetDeadline(deadline)
+				payload := bytes.Repeat([]byte("synthetic-upload"), 8192)
+				done := make(chan struct{})
+				server := &http2.Server{
+					MaxReadFrameSize:             frameSize,
+					MaxUploadBufferPerConnection: 1 << 20,
+					MaxUploadBufferPerStream:     1 << 20,
+				}
+				go func() {
+					defer close(done)
+					server.ServeConn(serverConn, &http2.ServeConnOpts{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+						if r.Method == "POST" {
+							body, err := io.ReadAll(r.Body)
+							if err != nil || !bytes.Equal(body, payload) {
+								w.WriteHeader(400)
+								return
+							}
+						}
+						w.WriteHeader(204)
+					})})
+				}()
+				var dialed atomic.Bool
+				dial := func(context.Context, string, string) (net.Conn, error) {
+					if dialed.Swap(true) {
+						return nil, fmt.Errorf("unexpected second connection")
+					}
+					return clientConn, nil
+				}
+				var transport interface {
+					http.RoundTripper
+					CloseIdleConnections()
+				}
+				if standalone {
+					transport = &http2.Transport{AllowHTTP: true, DialTLSContext: func(ctx context.Context, network, addr string, _ *tls.Config) (net.Conn, error) {
+						return dial(ctx, network, addr)
+					}}
+				} else {
+					protocols := new(http.Protocols)
+					protocols.SetUnencryptedHTTP2(true)
+					transport = &http.Transport{Protocols: protocols, DialContext: dial}
+				}
+				defer func() {
+					transport.CloseIdleConnections()
+					clientConn.Close()
+					serverConn.Close()
+					<-done
+				}()
+				client := &http.Client{Transport: transport}
+				request := func(method string, body io.Reader) {
+					t.Helper()
+					req, err := http.NewRequestWithContext(ctx, method, "http://buffer.invalid/upload", body)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if body != nil {
+						req.ContentLength = -1
+					}
+					resp, err := client.Do(req)
+					if err != nil {
+						t.Fatal(err)
+					}
+					io.Copy(io.Discard, resp.Body)
+					resp.Body.Close()
+					if resp.StatusCode != 204 {
+						t.Fatalf("response status = %d", resp.StatusCode)
+					}
+				}
+				// Wait for the peer's SETTINGS before allocating the upload buffer.
+				request("GET", nil)
+				body := &measuredBody{Reader: bytes.NewReader(payload)}
+				request("POST", body)
+				want := int64(32 << 10)
+				if int64(frameSize) < want {
+					want = int64(frameSize)
+				}
+				if got := body.maxRead.Load(); got != want {
+					t.Fatalf("largest body read = %d, want %d", got, want)
+				}
+			})
+		}
+	}
+}
