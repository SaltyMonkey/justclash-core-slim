+package http2
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestClientConnIdleTimerAfterStreamCompletion(t *testing.T) {
+	for _, closed := range []bool{false, true} {
+		name := "open"
+		if closed {
+			name = "closed"
+		}
+		t.Run(name, func(t *testing.T) {
+			timer := time.AfterFunc(time.Hour, func() {})
+			defer timer.Stop()
+			timer.Stop()
+			cc := &ClientConn{
+				t:           &Transport{},
+				closed:      closed,
+				streams:     map[uint32]*clientStream{1: {}},
+				idleTimer:   timer,
+				idleTimeout: time.Hour,
+			}
+			cc.cond = sync.NewCond(&cc.mu)
+			cc.forgetStreamID(1)
+			active := timer.Stop()
+			if active == closed {
+				t.Fatalf("idle timer active=%v after final stream completion with closed=%v", active, closed)
+			}
+		})
+	}
+}
