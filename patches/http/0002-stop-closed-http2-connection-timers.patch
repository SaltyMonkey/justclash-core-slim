+++ b/h2_closed_timer_test.go
@@ -0,0 +1,34 @@
+package http
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestHTTP2IdleTimerAfterStreamCompletion(t *testing.T) {
+	for _, closed := range []bool{false, true} {
+		name := "open"
+		if closed {
+			name = "closed"
+		}
+		t.Run(name, func(t *testing.T) {
+			timer := time.AfterFunc(time.Hour, func() {})
+			defer timer.Stop()
+			timer.Stop()
+			cc := &http2ClientConn{
+				t:           &http2Transport{},
+				closed:      closed,
+				streams:     map[uint32]*http2clientStream{1: {}},
+				idleTimer:   timer,
+				idleTimeout: time.Hour,
+			}
+			cc.cond = sync.NewCond(&cc.mu)
+			cc.forgetStreamID(1)
+			active := timer.Stop()
+			if active == closed {
+				t.Fatalf("idle timer active=%v after final stream completion with closed=%v", active, closed)
+			}
+		})
+	}
+}
