+package constant
+
+import (
+	"encoding/json"
+	"testing"
+
+	"go.yaml.in/yaml/v3"
+)
+
+func TestSlimTUNStackConfiguration(t *testing.T) {
+	cases := []struct {
+		name  string
+		want  TUNStack
+		valid bool
+	}{
+		{"system", TunSystem, true},
+		{"mips", TunMips, true},
+		{"MiPs", TunMips, true},
+		{"gvisor", 0, false},
+		{"mixed", 0, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var j, y struct {
+				Stack TUNStack `json:"stack" yaml:"stack"`
+			}
+			jerr := json.Unmarshal([]byte(`{"stack":"`+tc.name+`"}`), &j)
+			yerr := yaml.Unmarshal([]byte("stack: "+tc.name+"\n"), &y)
+			if (jerr == nil) != tc.valid || (yerr == nil) != tc.valid {
+				t.Fatal("unexpected stack acceptance in YAML/JSON")
+			}
+			if tc.valid && (j.Stack != tc.want || y.Stack != tc.want) {
+				t.Fatal("stack value changed during decoding")
+			}
+		})
+	}
+}
