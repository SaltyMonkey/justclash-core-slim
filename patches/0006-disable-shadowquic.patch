diff --git a/adapter/outbound/shadowquic_disabled_test.go b/adapter/outbound/shadowquic_disabled_test.go
new file mode 100644
--- /dev/null
+++ b/adapter/outbound/shadowquic_disabled_test.go
@@ -0,0 +1,21 @@
+//go:build no_shadowquic
+
+package outbound_test
+
+import (
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"strings"
+	"testing"
+)
+
+func TestSlimShadowQuicDisabled(t *testing.T) {
+	proxy, err := outbound.NewShadowQuic(outbound.ShadowQuicOption{})
+	if proxy != nil || err == nil || !strings.Contains(err.Error(), "disabled in slim builds") {
+		t.Fatal("disabled outbound must reject configuration before creating resources")
+	}
+	parsed, err := adapter.ParseProxy(map[string]any{"name": "disabled-test", "type": "shadowquic", "server": "", "port": 0, "password": "", "cipher": "", "obfs": "", "protocol": "", "up": "", "down": "", "ca": "", "psk": ""})
+	if parsed != nil || err == nil || !strings.Contains(err.Error(), "disabled in slim builds") {
+		t.Fatalf("proxy parser must report a disabled protocol: %v", err)
+	}
+}
diff --git a/adapter/outbound/shadowquic_stub.go b/adapter/outbound/shadowquic_stub.go
new file mode 100644
--- /dev/null
+++ b/adapter/outbound/shadowquic_stub.go
@@ -0,0 +1,40 @@
+//go:build no_shadowquic
+
+package outbound
+
+import (
+	"errors"
+)
+
+// Keep decoding intact; disabled protocols do not need a mystery error tour.
+type ShadowQuic struct{ *Base }
+type ShadowQuicOption struct {
+	BasicOption
+	Name                 string   `proxy:"name"`
+	Server               string   `proxy:"server"`
+	Port                 int      `proxy:"port"`
+	Username             string   `proxy:"username,omitempty"`
+	Password             string   `proxy:"password,omitempty"`
+	SNI                  string   `proxy:"sni,omitempty"`
+	ALPN                 []string `proxy:"alpn,omitempty"`
+	QUICVersions         []string `proxy:"quic-versions,omitempty"`
+	UDPOverStream        bool     `proxy:"udp-over-stream,omitempty"`
+	ZeroRTT              bool     `proxy:"zero-rtt,omitempty"`
+	KeepAliveInterval    int      `proxy:"keep-alive-interval,omitempty"`
+	CongestionController string   `proxy:"congestion-controller,omitempty"`
+	Up                   string   `proxy:"up,omitempty"`
+	Down                 string   `proxy:"down,omitempty"`
+	CWND                 int      `proxy:"cwnd,omitempty"`
+	BBRProfile           string   `proxy:"bbr-profile,omitempty"`
+	ReceiveWindowConn    int      `proxy:"recv-window-conn,omitempty"`
+	ReceiveWindow        int      `proxy:"recv-window,omitempty"`
+	DisableMTUDiscovery  bool     `proxy:"disable-mtu-discovery,omitempty"`
+	MaxDatagramFrameSize int      `proxy:"max-datagram-frame-size,omitempty"`
+	MaxOpenStreams       int      `proxy:"max-open-streams,omitempty"`
+}
+
+func NewShadowQuic(option ShadowQuicOption) (*ShadowQuic, error) {
+	return nil, errors.New("ShadowQuic support is disabled in slim builds")
+}
+
+var _ ProxyAdapter = (*ShadowQuic)(nil)
