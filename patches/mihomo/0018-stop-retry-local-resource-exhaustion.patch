Stop dial retries when the local host has exhausted socket resources.
Retrying the same failure cannot replenish sockets, descriptors or buffers.
Ordinary network failures retain their existing retry behavior.

Based on upstream PR #3062:
https://github.com/MetaCubeX/mihomo/pull/3062

diff --git a/tunnel/retry_error_unix.go b/tunnel/retry_error_unix.go
new file mode 100644
--- /dev/null
+++ b/tunnel/retry_error_unix.go
@@ -0,0 +1,15 @@
+//go:build !windows
+
+package tunnel
+
+import (
+	"errors"
+	"syscall"
+)
+
+func isLocalResourceExhaustion(err error) bool {
+	return errors.Is(err, syscall.EADDRNOTAVAIL) ||
+		errors.Is(err, syscall.EMFILE) ||
+		errors.Is(err, syscall.ENFILE) ||
+		errors.Is(err, syscall.ENOBUFS)
+}
diff --git a/tunnel/retry_error_windows.go b/tunnel/retry_error_windows.go
new file mode 100644
--- /dev/null
+++ b/tunnel/retry_error_windows.go
@@ -0,0 +1,16 @@
+//go:build windows
+
+package tunnel
+
+import (
+	"errors"
+
+	"golang.org/x/sys/windows"
+)
+
+func isLocalResourceExhaustion(err error) bool {
+	return errors.Is(err, windows.WSAEADDRNOTAVAIL) ||
+		errors.Is(err, windows.WSAEMFILE) ||
+		errors.Is(err, windows.ERROR_TOO_MANY_OPEN_FILES) ||
+		errors.Is(err, windows.WSAENOBUFS)
+}
