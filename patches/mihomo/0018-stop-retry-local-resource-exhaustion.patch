 func shouldStopRetry(err error) bool {
+	// Retrying cannot conjure up local sockets or descriptors.
+	// See https://github.com/MetaCubeX/mihomo/pull/3062.
+	if isLocalResourceExhaustion(err) {
+		return true
+	}
 	if errors.Is(err, resolver.ErrIPNotFound) {
 		return true
 	}
diff --git a/tunnel/retry_error_test.go b/tunnel/retry_error_test.go
new file mode 100644
--- /dev/null
+++ b/tunnel/retry_error_test.go
@@ -0,0 +1,86 @@
+package tunnel
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"testing"
+)
+
+func TestRetryStopsOnLocalResourceExhaustion(t *testing.T) {
+	for index, resourceErr := range localResourceErrors() {
+		cases := []struct {
+			name string
+			err  error
+		}{
+			{"direct", resourceErr},
+			{"wrapped", fmt.Errorf("dial failed: %w", resourceErr)},
+			{"syscall", &net.OpError{Op: "dial", Net: "tcp", Err: os.NewSyscallError("socket", resourceErr)}},
+			{"joined", errors.Join(errors.New("another dial failed"), resourceErr)},
+		}
+		for _, tc := range cases {
+			t.Run(fmt.Sprintf("resource-%d/%s", index, tc.name), func(t *testing.T) {
+				attempts, notifications := 0, 0
+				_, err := retry[int](context.Background(), func(context.Context) (int, error) {
+					attempts++
+					return 0, tc.err
+				}, func(error) {
+					notifications++
+				})
+				if attempts != 1 || notifications != 1 {
+					t.Fatalf("got %d attempts and %d notifications, want one each", attempts, notifications)
+				}
+				if !errors.Is(err, resourceErr) {
+					t.Fatal("retry did not preserve the resource error")
+				}
+			})
+		}
+	}
+}
+
+func TestLocalResourceExhaustionClassification(t *testing.T) {
+	for _, err := range []error{
+		nil,
+		errors.New("ordinary network failure"),
+		context.Canceled,
+		context.DeadlineExceeded,
+		net.ErrClosed,
+		os.ErrPermission,
+	} {
+		if isLocalResourceExhaustion(err) {
+			t.Fatal("an unrelated error was classified as resource exhaustion")
+		}
+	}
+}
+
+func TestRetryContinuesAfterTransientDialError(t *testing.T) {
+	transient := errors.New("temporary dial failure")
+	attempts, notifications := 0, 0
+	value, err := retry[int](context.Background(), func(context.Context) (int, error) {
+		attempts++
+		if attempts == 1 {
+			return 0, transient
+		}
+		return 42, nil
+	}, func(error) {
+		notifications++
+	})
+	if err != nil || value != 42 || attempts != 2 || notifications != 1 {
+		t.Fatal("a transient failure did not retain the normal retry behavior")
+	}
+}
+
+func TestRetryResourceCheckPreservesSuccess(t *testing.T) {
+	attempts, notifications := 0, 0
+	value, err := retry[int](context.Background(), func(context.Context) (int, error) {
+		attempts++
+		return 42, nil
+	}, func(error) {
+		notifications++
+	})
+	if err != nil || value != 42 || attempts != 1 || notifications != 0 {
+		t.Fatal("a successful dial did not retain the normal retry behavior")
+	}
+}
