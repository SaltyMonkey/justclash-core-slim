@@ -0,0 +1,97 @@
+package cidr
+
+import (
+	"bytes"
+	"encoding/hex"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+)
+
+type slimIPReader struct {
+	data []byte
+	err  error
+}
+
+func (r *slimIPReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if len(r.data) == 0 {
+		return 0, r.err
+	}
+	n := copy(p[:1], r.data)
+	r.data = r.data[n:]
+	if len(r.data) == 0 {
+		return n, r.err
+	}
+	return n, nil
+}
+
+func slimIPGolden(t *testing.T) []byte {
+	t.Helper()
+	// Handwritten wire bytes keep the writer out of the witness box.
+	data, err := hex.DecodeString(strings.Join([]string{
+		"010000000000000003",
+		"00000000000000000000ffffc0000201", "00000000000000000000ffffc00002ff",
+		"00000000000000000000ffffc6336400", "00000000000000000000ffffc633647f",
+		"20010db8000000000000000000000001", "20010db80000000000000000000000ff",
+	}, ""))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func TestSlimIPBinaryGoldenAndReadFailures(t *testing.T) {
+	data := slimIPGolden(t)
+	got, err := ReadIpCidrSet(&slimIPReader{data, io.EOF})
+	if err != nil {
+		t.Fatal(err)
+	}
+	queries := []struct {
+		value string
+		want  bool
+	}{
+		{"192.0.2.0", false}, {"192.0.2.1", true}, {"192.0.2.255", true}, {"192.0.3.0", false},
+		{"198.51.100.0", true}, {"198.51.100.127", true}, {"198.51.100.128", false},
+		{"2001:db8::", false}, {"2001:db8::1", true}, {"2001:db8::ff", true}, {"2001:db8::100", false},
+	}
+	for index, query := range queries {
+		if got.IsContainForString(query.value) != query.want {
+			t.Fatalf("golden lookup %d changed", index)
+		}
+	}
+	for index, span := range got.rr {
+		if (index < 2) != span.From().Is4() || (index < 2) != span.To().Is4() {
+			t.Fatal("address family changed")
+		}
+	}
+	var encoded bytes.Buffer
+	if err := got.WriteBin(&encoded); err != nil || !bytes.Equal(data, encoded.Bytes()) {
+		t.Fatal("golden wire representation changed")
+	}
+	wantErr := errors.New("injected reader failure")
+	for cut := 0; cut < len(data); cut++ {
+		result, err := ReadIpCidrSet(&slimIPReader{data[:cut], wantErr})
+		if result != nil || !errors.Is(err, wantErr) {
+			t.Fatalf("read failure at byte %d was lost: %v", cut, err)
+		}
+	}
+}
+
+func TestSlimIPBinaryAllocationGrowth(t *testing.T) {
+	allocs := func(count int) float64 {
+		_, data := cidrBinaryFixture(t, count)
+		return testing.AllocsPerRun(10, func() {
+			if _, err := ReadIpCidrSet(bytes.NewReader(data)); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+	small, large := allocs(1), allocs(10000)
+	if large > small+8 {
+		t.Fatalf("allocations scale with range count: %.0f -> %.0f", small, large)
+	}
+}
