--- /dev/null
+++ b/rules/provider/mrs_reader_memory_test.go
@@ -0,0 +1,131 @@
+package provider
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"net/netip"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+
+	"github.com/klauspost/compress/zstd"
+)
+
+func mrsMemoryFixture(tb testing.TB, count int) ([]byte, []byte) {
+	tb.Helper()
+	strategy := NewDomainStrategy()
+	for i := 0; i < count; i++ {
+		strategy.Insert(fmt.Sprintf("+.node-%d.example.com", i))
+	}
+	strategy.FinishInsert()
+	var raw bytes.Buffer
+	raw.Write(MrsMagicBytes[:])
+	raw.WriteByte(strategy.Behavior().Byte())
+	binary.Write(&raw, binary.BigEndian, int64(strategy.Count()))
+	binary.Write(&raw, binary.BigEndian, int64(0))
+	if err := strategy.WriteMrs(&raw); err != nil {
+		tb.Fatal(err)
+	}
+	encoder, err := zstd.NewWriter(nil, zstd.WithEncoderCRC(true))
+	if err != nil {
+		tb.Fatal(err)
+	}
+	defer encoder.Close()
+	return encoder.EncodeAll(raw.Bytes(), nil), raw.Bytes()
+}
+
+func TestMrsMemoryDecoderCompatibility(t *testing.T) {
+	for _, count := range []int{1, 50000} {
+		t.Run(fmt.Sprint(count), func(t *testing.T) {
+			data, raw := mrsMemoryFixture(t, count)
+			got, err := rulesMrsParse(data, NewDomainStrategy())
+			if err != nil {
+				t.Fatal(err)
+			}
+			reference := NewDomainStrategy()
+			if err = reference.FromMrs(bytes.NewReader(raw[21:]), count); err != nil {
+				t.Fatal(err)
+			}
+			if got.Count() != reference.Count() {
+				t.Fatal("count changed")
+			}
+			for _, host := range []string{"node-0.example.com", "www.node-0.example.com", "node-60000.example.com", "example.com"} {
+				metadata := &C.Metadata{Host: host}
+				if got.Match(metadata, C.RuleMatchHelper{}) != reference.Match(metadata, C.RuleMatchHelper{}) {
+					t.Fatalf("lookup changed: %s", host)
+				}
+			}
+			// Last four bytes are the zstd frame checksum. A complete rule payload
+			// must still reject a damaged or truncated frame after synchronous decoding.
+			broken := append([]byte{}, data...)
+			broken[len(broken)-1] ^= 1
+			if _, err = rulesMrsParse(broken, NewDomainStrategy()); err == nil {
+				t.Fatal("accepted invalid zstd checksum")
+			}
+			for _, n := range []int{0, 1, 4, len(data) / 2, len(data) - 4, len(data) - 1} {
+				if _, err = rulesMrsParse(data[:n], NewDomainStrategy()); err == nil {
+					t.Fatalf("accepted truncated frame at %d", n)
+				}
+			}
+		})
+	}
+}
+
+func BenchmarkMrsReadMemory(b *testing.B) {
+	data, _ := mrsMemoryFixture(b, 50000)
+	b.ReportAllocs()
+	b.SetBytes(int64(len(data)))
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		if _, err := rulesMrsParse(data, NewDomainStrategy()); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func TestMrsIPMemoryDecoderCompatibility(t *testing.T) {
+	strategy := NewIPCidrStrategy()
+	strategy.Reset()
+	for _, prefix := range []string{"10.0.0.0/24", "192.0.2.0/24", "2001:db8::/32"} {
+		strategy.Insert(prefix)
+	}
+	strategy.FinishInsert()
+	var raw bytes.Buffer
+	raw.Write(MrsMagicBytes[:])
+	raw.WriteByte(strategy.Behavior().Byte())
+	binary.Write(&raw, binary.BigEndian, int64(strategy.Count()))
+	binary.Write(&raw, binary.BigEndian, int64(0))
+	if err := strategy.WriteMrs(&raw); err != nil {
+		t.Fatal(err)
+	}
+	encoder, err := zstd.NewWriter(nil, zstd.WithEncoderCRC(true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer encoder.Close()
+	data := encoder.EncodeAll(raw.Bytes(), nil)
+	got, err := rulesMrsParse(data, NewIPCidrStrategy())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Count() != strategy.Count() {
+		t.Fatal("count changed")
+	}
+	for _, ip := range []string{"10.0.0.1", "10.0.1.1", "192.0.2.1", "2001:db8::1", "2001:db9::1"} {
+		metadata := &C.Metadata{DstIP: netip.MustParseAddr(ip)}
+		if got.Match(metadata, C.RuleMatchHelper{}) != strategy.Match(metadata, C.RuleMatchHelper{}) {
+			t.Fatalf("lookup changed: %s", ip)
+		}
+	}
+	broken := append([]byte{}, data...)
+	broken[len(broken)-1] ^= 1
+	if _, err := rulesMrsParse(broken, NewIPCidrStrategy()); err == nil {
+		t.Fatal("accepted invalid zstd checksum")
+	}
+	for _, n := range []int{0, 1, 4, len(data) / 2, len(data) - 4, len(data) - 1} {
+		if _, err := rulesMrsParse(data[:n], NewIPCidrStrategy()); err == nil {
+			t.Fatalf("accepted truncated IP frame at %d", n)
+		}
+	}
+}
diff --git a/component/trie/domain_set_bin_slim_test.go b/component/trie/domain_set_bin_slim_test.go
new file mode 100644
--- /dev/null
+++ b/component/trie/domain_set_bin_slim_test.go
@@ -0,0 +1,132 @@
+package trie
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"testing"
+)
+
+type slimDomainReader struct {
+	data []byte
+	step int
+	err  error
+}
+
+func (r *slimDomainReader) Read(p []byte) (int, error) {
+	if len(r.data) == 0 {
+		return 0, r.err
+	}
+	if len(p) > r.step {
+		p = p[:r.step]
+	}
+	n := copy(p, r.data)
+	r.data = r.data[n:]
+	if len(r.data) == 0 {
+		return n, r.err
+	}
+	return n, nil
+}
+
+func TestSlimDomainBinaryReadFailures(t *testing.T) {
+	_, data := domainBinaryFixture(t, 65)
+	wantErr := errors.New("injected reader failure")
+	// An I/O failure deserves to survive decoding without a creative rewrite.
+	for cut := 0; cut < len(data); cut++ {
+		got, err := ReadDomainSetBin(&slimDomainReader{data[:cut], 1, wantErr})
+		if got != nil || !errors.Is(err, wantErr) {
+			t.Fatalf("read failure at byte %d was lost: %v", cut, err)
+		}
+	}
+}
+
+func TestSlimDomainBinaryBufferOwnership(t *testing.T) {
+	for _, count := range []int{1, 63, 64, 65, 127, 128, 129, 1024} {
+		t.Run(fmt.Sprint(count), func(t *testing.T) {
+			want, data := domainBinaryFixture(t, count)
+			original := append([]byte(nil), data...)
+			for _, step := range []int{1, 2, 7, 8, 15} {
+				got, err := ReadDomainSetBin(&slimDomainReader{data, step, io.EOF})
+				if err != nil {
+					t.Fatal(err)
+				}
+				for i := 0; i < count; i++ {
+					host := fmt.Sprintf("www.node-%d.example.com", i)
+					if !got.Has(host) || !want.Has(host) {
+						t.Fatalf("known member lost with chunk size %d", step)
+					}
+				}
+				var encoded bytes.Buffer
+				if err := got.WriteBin(&encoded); err != nil || !bytes.Equal(original, encoded.Bytes()) {
+					t.Fatal("word order or binary format changed")
+				}
+				got.leaves[0] ^= 1
+				got.labelBitmap[0] ^= 1
+				got.labels[0] ^= 1
+				if !bytes.Equal(original, data) {
+					t.Fatal("decoded buffers alias the input")
+				}
+			}
+		})
+	}
+}
+
+func TestSlimDomainBinaryAllocationGrowth(t *testing.T) {
+	allocs := func(count int) float64 {
+		_, data := domainBinaryFixture(t, count)
+		return testing.AllocsPerRun(10, func() {
+			if _, err := ReadDomainSetBin(bytes.NewReader(data)); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+	small, large := allocs(1), allocs(10000)
+	if large > small+8 {
+		t.Fatalf("allocations scale with rule count: %.0f -> %.0f", small, large)
+	}
+}
+
+func FuzzSlimDomainBinaryRoundTrip(f *testing.F) {
+	f.Add([]byte{0, 1, 63, 64, 127, 255})
+	f.Add([]byte{})
+	f.Fuzz(func(t *testing.T, seed []byte) {
+		if len(seed) > 128 {
+			t.Skip()
+		}
+		var builder DomainSetBuilder
+		if err := builder.Insert("anchor.example.com"); err != nil {
+			t.Fatal(err)
+		}
+		for i, value := range seed {
+			pattern := fmt.Sprintf("node-%d-%d.example.com", i, value)
+			if value&1 != 0 {
+				pattern = "+." + pattern
+			}
+			if err := builder.Insert(pattern); err != nil {
+				t.Fatal(err)
+			}
+		}
+		want := builder.Build()
+		var original bytes.Buffer
+		if err := want.WriteBin(&original); err != nil {
+			t.Fatal(err)
+		}
+		got, err := ReadDomainSetBin(&slimDomainReader{original.Bytes(), 1 + len(seed)%17, io.EOF})
+		if err != nil {
+			t.Fatal(err)
+		}
+		for i, value := range seed {
+			host := fmt.Sprintf("node-%d-%d.example.com", i, value)
+			for _, query := range []string{host, "www." + host, "other." + host} {
+				if got.Has(query) != want.Has(query) {
+					t.Fatal("lookup changed after binary round trip")
+				}
+			}
+		}
+		var encoded bytes.Buffer
+		if err := got.WriteBin(&encoded); err != nil || !bytes.Equal(original.Bytes(), encoded.Bytes()) {
+			t.Fatal("binary representation changed")
+		}
+	})
+}
