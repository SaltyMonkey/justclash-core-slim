+package provider
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"net/netip"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+
+	"github.com/klauspost/compress/zstd"
+)
+
+func slimMrsStrategy(tb testing.TB, kind string, count int) mrsRuleStrategy {
+	tb.Helper()
+	var strategy mrsRuleStrategy = NewDomainStrategy()
+	if kind == "ipcidr" {
+		strategy = NewIPCidrStrategy()
+	}
+	strategy.Reset()
+	for index := 0; index < count; index++ {
+		if kind == "ipcidr" {
+			strategy.Insert(fmt.Sprintf("10.%d.%d.0/25", index/256, index%256))
+		} else {
+			strategy.Insert(fmt.Sprintf("+.node-%d.example.com", index))
+		}
+	}
+	if kind == "ipcidr" {
+		strategy.Insert("2001:db8::/64")
+	}
+	strategy.FinishInsert()
+	return strategy
+}
+
+func slimMrsRaw(tb testing.TB, strategy mrsRuleStrategy) []byte {
+	tb.Helper()
+	var raw bytes.Buffer
+	raw.Write(MrsMagicBytes[:])
+	raw.WriteByte(strategy.Behavior().Byte())
+	for _, value := range []int64{int64(strategy.Count()), 3} {
+		if err := binary.Write(&raw, binary.BigEndian, value); err != nil {
+			tb.Fatal(err)
+		}
+	}
+	raw.Write([]byte{0xa1, 0xb2, 0xc3})
+	if err := strategy.WriteMrs(&raw); err != nil {
+		tb.Fatal(err)
+	}
+	return raw.Bytes()
+}
+
+func slimMrsEncode(tb testing.TB, raw []byte, crc bool, window int) []byte {
+	tb.Helper()
+	encoder, err := zstd.NewWriter(nil, zstd.WithEncoderConcurrency(1), zstd.WithEncoderCRC(crc), zstd.WithWindowSize(window))
+	if err != nil {
+		tb.Fatal(err)
+	}
+	defer encoder.Close()
+	return encoder.EncodeAll(raw, nil)
+}
+
+func slimMrsCheck(tb testing.TB, data []byte, kind string, want mrsRuleStrategy) {
+	tb.Helper()
+	var target ruleStrategy = NewDomainStrategy()
+	if kind == "ipcidr" {
+		target = NewIPCidrStrategy()
+	}
+	parsed, err := rulesMrsParse(data, target)
+	if err != nil {
+		tb.Fatal(err)
+	}
+	if parsed.Count() != want.Count() {
+		tb.Fatal("rule count changed")
+	}
+	var original, encoded bytes.Buffer
+	if err := want.WriteMrs(&original); err != nil {
+		tb.Fatal(err)
+	}
+	if err := parsed.(mrsRuleStrategy).WriteMrs(&encoded); err != nil || !bytes.Equal(original.Bytes(), encoded.Bytes()) {
+		tb.Fatal("decoded rule representation changed")
+	}
+	queries := []*C.Metadata{
+		{Host: "node-0.example.com"}, {Host: "www.node-2.example.com"}, {Host: "absent.example.com"},
+		{DstIP: netip.MustParseAddr("10.0.2.1")}, {DstIP: netip.MustParseAddr("10.0.2.128")},
+		{DstIP: netip.MustParseAddr("2001:db8::1")}, {DstIP: netip.MustParseAddr("2001:db8:1::1")},
+	}
+	for _, query := range queries {
+		if parsed.Match(query, C.RuleMatchHelper{}) != want.Match(query, C.RuleMatchHelper{}) {
+			tb.Fatal("decoded lookup changed")
+		}
+	}
+}
+
+func TestSlimMrsFrameVariants(t *testing.T) {
+	for _, kind := range []string{"domain", "ipcidr"} {
+		for _, count := range []int{3, 10000} {
+			kind, count := kind, count
+			t.Run(fmt.Sprintf("%s/%d", kind, count), func(t *testing.T) {
+				t.Parallel()
+				want := slimMrsStrategy(t, kind, count)
+				raw := slimMrsRaw(t, want)
+				for _, window := range []int{1024, 1 << 20} {
+					for _, crc := range []bool{false, true} {
+						data := slimMrsEncode(t, raw, crc, window)
+						slimMrsCheck(t, data, kind, want)
+					}
+				}
+				// Each frame has its own checksum; the decoded MRS spans all three.
+				var framed []byte
+				boundaries := []int{0, 11, len(raw) / 2, len(raw)}
+				for index := 0; index+1 < len(boundaries); index++ {
+					framed = append(framed, slimMrsEncode(t, raw[boundaries[index]:boundaries[index+1]], true, 1024)...)
+				}
+				slimMrsCheck(t, framed, kind, want)
+			})
+		}
+	}
+}
+
+func TestSlimMrsEveryTruncation(t *testing.T) {
+	for _, kind := range []string{"domain", "ipcidr"} {
+		strategy := slimMrsStrategy(t, kind, 3)
+		data := slimMrsEncode(t, slimMrsRaw(t, strategy), true, 1024)
+		newTarget := func() ruleStrategy {
+			if kind == "ipcidr" {
+				return NewIPCidrStrategy()
+			}
+			return NewDomainStrategy()
+		}
+		for cut := 0; cut < len(data); cut++ {
+			if _, err := rulesMrsParse(data[:cut], newTarget()); err == nil {
+				t.Fatalf("%s accepted frame truncated at byte %d", kind, cut)
+			}
+		}
+		for index := len(data) - 4; index < len(data); index++ {
+			damaged := append([]byte(nil), data...)
+			damaged[index] ^= 1
+			if _, err := rulesMrsParse(damaged, newTarget()); err == nil {
+				t.Fatalf("%s accepted checksum corruption at byte %d", kind, index)
+			}
+		}
+	}
+}
+
+func BenchmarkSlimMrsDecode(b *testing.B) {
+	for _, kind := range []string{"domain", "ipcidr"} {
+		kind := kind
+		b.Run(kind, func(b *testing.B) {
+			count := 50000
+			if kind == "ipcidr" {
+				count = 10000
+			}
+			strategy := slimMrsStrategy(b, kind, count)
+			data := slimMrsEncode(b, slimMrsRaw(b, strategy), true, 1<<20)
+			b.ReportAllocs()
+			b.SetBytes(int64(len(data)))
+			b.ResetTimer()
+			for index := 0; index < b.N; index++ {
+				var target ruleStrategy = NewDomainStrategy()
+				if kind == "ipcidr" {
+					target = NewIPCidrStrategy()
+				}
+				if _, err := rulesMrsParse(data, target); err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
