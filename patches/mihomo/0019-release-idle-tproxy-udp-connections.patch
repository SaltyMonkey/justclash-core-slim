+package nat
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func localConnTestTable() *Table {
+	table := New()
+	table.GetOrCreate("local", func() C.PacketSender { return nil })
+	return table
+}
+
+func TestDeleteLocalConnIf(t *testing.T) {
+	table := localConnTestTable()
+	old, replacement := &net.UDPConn{}, &net.UDPConn{}
+	table.AddForLocalConn("local", "remote", old, nil)
+	table.DeleteForLocalConnIf("local", "remote", replacement)
+	if table.GetForLocalConn("local", "remote") != old {
+		t.Fatal("mismatched socket was removed")
+	}
+	table.DeleteForLocalConnIf("local", "remote", old)
+	if table.GetForLocalConn("local", "remote") != nil {
+		t.Fatal("matching socket remains cached")
+	}
+	table.DeleteForLocalConnIf("missing", "remote", old)
+	table.DeleteForLocalConnIf("local", "missing", old)
+}
+
+func TestLocalConnReplacementSurvivesCleanup(t *testing.T) {
+	table := localConnTestTable()
+	old, replacement := &net.UDPConn{}, &net.UDPConn{}
+	for i := 0; i < 2000; i++ {
+		table.AddForLocalConn("local", "remote", old, nil)
+		start, done := make(chan struct{}), make(chan struct{})
+		go func() {
+			defer close(done)
+			<-start
+			table.DeleteForLocalConnIf("local", "remote", old)
+		}()
+		close(start)
+		table.AddForLocalConn("local", "remote", replacement, nil)
+		<-done
+		if table.GetForLocalConn("local", "remote") != replacement {
+			t.Fatal("retired reader removed the replacement")
+		}
+	}
+}
+
+func TestLocalConnCreationGeneration(t *testing.T) {
+	table := localConnTestTable()
+	oldLock, _ := table.GetOrCreateLockForLocalConn("local", "remote")
+	defer oldLock.L.Unlock()
+	table.Delete("local")
+	table.GetOrCreate("local", func() C.PacketSender { return nil })
+	newLock, _ := table.GetOrCreateLockForLocalConn("local", "remote")
+	defer newLock.L.Unlock()
+	replacement := &net.UDPConn{}
+	if table.AddForLocalConn("local", "remote", &net.UDPConn{}, oldLock) {
+		t.Fatal("old creator published into a replacement NAT entry")
+	}
+	if !table.AddForLocalConn("local", "remote", replacement, newLock) {
+		t.Fatal("current creator could not publish")
+	}
+	table.DeleteLockForLocalConn("local", "remote", oldLock)
+	current, loaded := table.GetOrCreateLockForLocalConn("local", "remote")
+	if !loaded || current != newLock {
+		t.Fatal("old creator removed the new creation lock")
+	}
+	table.DeleteForLocalConnIf("local", "remote", &net.UDPConn{})
+	if table.GetForLocalConn("local", "remote") != replacement {
+		t.Fatal("replacement NAT entry lost its socket")
+	}
+}
+
+func TestLocalConnCreationLockIsPublishedHeld(t *testing.T) {
+	table := localConnTestTable()
+	lock, loaded := table.GetOrCreateLockForLocalConn("local", "remote")
+	if loaded {
+		t.Fatal("unexpected existing creation lock")
+	}
+	other, loaded := table.GetOrCreateLockForLocalConn("local", "remote")
+	if !loaded || other != lock {
+		t.Fatal("waiter did not share the creator's lock")
+	}
+	started, acquired := make(chan struct{}), make(chan struct{})
+	go func() {
+		close(started)
+		other.L.Lock()
+		close(acquired)
+		other.L.Unlock()
+	}()
+	<-started
+	select {
+	case <-acquired:
+		t.Fatal("waiter passed an unfinished creator")
+	case <-time.After(20 * time.Millisecond):
+	}
+	table.DeleteLockForLocalConn("local", "remote", lock)
+	lock.L.Unlock()
+	select {
+	case <-acquired:
+	case <-time.After(2 * time.Second):
+		t.Fatal("waiter was not released")
+	}
+}
