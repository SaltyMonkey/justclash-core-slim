@@ -0,0 +1,332 @@
+package tproxy
+
+import (
+	"bytes"
+	"errors"
+	"net"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/component/nat"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type idleTestTunnel struct {
+	C.Tunnel
+	table   C.NatTable
+	packets chan []byte
+}
+
+func (t *idleTestTunnel) NatTable() C.NatTable { return t.table }
+func (t *idleTestTunnel) HandleUDPPacket(packet C.UDPPacket, _ *C.Metadata) {
+	data := append([]byte(nil), packet.Data()...)
+	packet.Drop()
+	t.packets <- data
+}
+
+func idleTestPair(t *testing.T) (*net.UDPConn, *net.UDPConn) {
+	t.Helper()
+	peer, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal("could not create test peer")
+	}
+	t.Cleanup(func() { peer.Close() })
+	conn, err := net.DialUDP("udp4", nil, peer.LocalAddr().(*net.UDPAddr))
+	if err != nil {
+		t.Fatal("could not create test connection")
+	}
+	t.Cleanup(func() { conn.Close() })
+	return conn, peer
+}
+func idleTestState(t *testing.T, conn *net.UDPConn) (*nat.Table, *idleTestTunnel, netip.AddrPort, netip.AddrPort) {
+	t.Helper()
+	local := conn.LocalAddr().(*net.UDPAddr).AddrPort()
+	remote := conn.RemoteAddr().(*net.UDPAddr).AddrPort()
+	table := nat.New()
+	table.GetOrCreate(local.String(), func() C.PacketSender { return nil })
+	table.AddForLocalConn(local.String(), remote.String(), conn, nil)
+	tunnel := &idleTestTunnel{table: table, packets: make(chan []byte, 8)}
+	return table, tunnel, local, remote
+}
+func idleTestStart(t *testing.T, conn *net.UDPConn, tunnel C.Tunnel, local, remote netip.AddrPort, idle time.Duration) <-chan struct{} {
+	t.Helper()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		serveLocalConn(conn, remote, local, tunnel, idle)
+	}()
+	t.Cleanup(func() { conn.Close(); idleTestWait(t, done) })
+	return done
+}
+func idleTestWait(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("local reader did not finish")
+	}
+}
+func idleTestStillRunning(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-done:
+		t.Fatal("an active local reader expired")
+	default:
+	}
+}
+
+func TestServeLocalConnIdleExit(t *testing.T) {
+	conn, _ := idleTestPair(t)
+	table, tunnel, local, remote := idleTestState(t, conn)
+	done := idleTestStart(t, conn, tunnel, local, remote, 30*time.Millisecond)
+	idleTestWait(t, done)
+	if table.GetForLocalConn(local.String(), remote.String()) != nil {
+		t.Fatal("idle socket remains cached")
+	}
+	if _, err := conn.Write([]byte("closed")); !errors.Is(err, net.ErrClosed) {
+		t.Fatal("idle socket remains open")
+	}
+	select {
+	case <-tunnel.packets:
+		t.Fatal("read failure was forwarded as a packet")
+	default:
+	}
+}
+
+func TestServeLocalConnClosedExit(t *testing.T) {
+	conn, _ := idleTestPair(t)
+	table, tunnel, local, remote := idleTestState(t, conn)
+	done := idleTestStart(t, conn, tunnel, local, remote, time.Second)
+	conn.Close()
+	idleTestWait(t, done)
+	if table.GetForLocalConn(local.String(), remote.String()) != nil {
+		t.Fatal("externally closed socket remains cached")
+	}
+}
+
+func TestServeLocalConnPreservesReplacement(t *testing.T) {
+	conn, _ := idleTestPair(t)
+	replacement, _ := idleTestPair(t)
+	table, tunnel, local, remote := idleTestState(t, conn)
+	done := idleTestStart(t, conn, tunnel, local, remote, time.Second)
+	table.AddForLocalConn(local.String(), remote.String(), replacement, nil)
+	conn.Close()
+	idleTestWait(t, done)
+	if table.GetForLocalConn(local.String(), remote.String()) != replacement {
+		t.Fatal("old reader removed the replacement")
+	}
+	if _, err := replacement.Write([]byte("alive")); err != nil {
+		t.Fatal("old reader closed the replacement")
+	}
+}
+
+func TestServeLocalConnReadRefreshesIdle(t *testing.T) {
+	conn, peer := idleTestPair(t)
+	_, tunnel, local, remote := idleTestState(t, conn)
+	done := idleTestStart(t, conn, tunnel, local, remote, 300*time.Millisecond)
+	time.Sleep(180 * time.Millisecond)
+	payload := []byte("activity")
+	if _, err := peer.WriteToUDP(payload, conn.LocalAddr().(*net.UDPAddr)); err != nil {
+		t.Fatal("could not send test packet")
+	}
+	select {
+	case got := <-tunnel.packets:
+		if !bytes.Equal(got, payload) {
+			t.Fatal("received packet changed")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("reader did not forward the packet")
+	}
+	time.Sleep(180 * time.Millisecond)
+	idleTestStillRunning(t, done)
+}
+
+func TestWriteBackRefreshesIdle(t *testing.T) {
+	conn, peer := idleTestPair(t)
+	_, tunnel, local, remote := idleTestState(t, conn)
+	done := idleTestStart(t, conn, tunnel, local, remote, 300*time.Millisecond)
+	time.Sleep(180 * time.Millisecond)
+	packet := &packet{lAddr: local, tunnel: tunnel}
+	payload := []byte("reply")
+	n, err := packet.WriteBack(payload, net.UDPAddrFromAddrPort(remote))
+	if err != nil || n != len(payload) {
+		t.Fatal("writeback failed")
+	}
+	peer.SetReadDeadline(time.Now().Add(time.Second))
+	buf := make([]byte, 32)
+	n, _, err = peer.ReadFromUDP(buf)
+	if err != nil || !bytes.Equal(buf[:n], payload) {
+		t.Fatal("reply did not reach the peer")
+	}
+	time.Sleep(180 * time.Millisecond)
+	idleTestStillRunning(t, done)
+}
+
+type replaceOnDeleteTable struct {
+	C.NatTable
+	old, replacement *net.UDPConn
+	before           bool
+	calls            int
+}
+
+func (t *replaceOnDeleteTable) DeleteForLocalConnIf(local, remote string, expected *net.UDPConn) {
+	t.calls++
+	if expected != t.old {
+		panic("writeback tried to remove a different socket")
+	}
+	if t.before {
+		t.NatTable.AddForLocalConn(local, remote, t.replacement, nil)
+	}
+	t.NatTable.DeleteForLocalConnIf(local, remote, expected)
+	if !t.before {
+		t.NatTable.AddForLocalConn(local, remote, t.replacement, nil)
+	}
+}
+
+func TestWriteBackRecreatesClosedCachedConn(t *testing.T) {
+	for _, before := range []bool{false, true} {
+		t.Run(map[bool]string{false: "after-delete", true: "concurrent-replacement"}[before], func(t *testing.T) {
+			old, _ := idleTestPair(t)
+			fresh, peer := idleTestPair(t)
+			table, tunnel, local, remote := idleTestState(t, fresh)
+			table.AddForLocalConn(local.String(), remote.String(), old, nil)
+			old.Close()
+			replacementTable := &replaceOnDeleteTable{NatTable: table, old: old, replacement: fresh, before: before}
+			tunnel.table = replacementTable
+			packet := &packet{lAddr: local, tunnel: tunnel}
+			payload := []byte("recreated")
+			n, err := packet.WriteBack(payload, net.UDPAddrFromAddrPort(remote))
+			if err != nil || n != len(payload) || replacementTable.calls != 1 {
+				t.Fatal("closed cached socket was not replaced once")
+			}
+			peer.SetReadDeadline(time.Now().Add(time.Second))
+			buf := make([]byte, 32)
+			n, _, err = peer.ReadFromUDP(buf)
+			if err != nil || !bytes.Equal(buf[:n], payload) {
+				t.Fatal("retry did not use the replacement")
+			}
+			if table.GetForLocalConn(local.String(), remote.String()) != fresh {
+				t.Fatal("replacement was evicted")
+			}
+		})
+	}
+}
+
+func TestWriteBackRetriesClosedConnOnlyOnce(t *testing.T) {
+	old, _ := idleTestPair(t)
+	fresh, _ := idleTestPair(t)
+	table, tunnel, local, remote := idleTestState(t, fresh)
+	table.AddForLocalConn(local.String(), remote.String(), old, nil)
+	old.Close()
+	fresh.Close()
+	replacementTable := &replaceOnDeleteTable{NatTable: table, old: old, replacement: fresh}
+	tunnel.table = replacementTable
+	packet := &packet{lAddr: local, tunnel: tunnel}
+	_, err := packet.WriteBack([]byte("retry"), net.UDPAddrFromAddrPort(remote))
+	if !errors.Is(err, net.ErrClosed) || replacementTable.calls != 1 {
+		t.Fatal("closed socket retry was not bounded")
+	}
+}
+
+type observedLockTable struct {
+	C.NatTable
+	observed chan struct{}
+	release  <-chan struct{}
+	once     sync.Once
+}
+
+func (t *observedLockTable) GetOrCreateLockForLocalConn(local, remote string) (*sync.Cond, bool) {
+	lock, loaded := t.NatTable.GetOrCreateLockForLocalConn(local, remote)
+	t.once.Do(func() { close(t.observed) })
+	if t.release != nil {
+		<-t.release
+	}
+	return lock, loaded
+}
+
+func TestLocalConnWaiterCompletesAfterCreator(t *testing.T) {
+	for _, success := range []bool{false, true} {
+		for _, late := range []bool{false, true} {
+			name := map[bool]string{false: "failure", true: "success"}[success] + "/" + map[bool]string{false: "waiting", true: "already-finished"}[late]
+			t.Run(name, func(t *testing.T) {
+				conn, _ := idleTestPair(t)
+				table, tunnel, local, remote := idleTestState(t, conn)
+				table.DeleteForLocalConnIf(local.String(), remote.String(), conn)
+				lock, _ := table.GetOrCreateLockForLocalConn(local.String(), remote.String())
+				observed := &observedLockTable{NatTable: table, observed: make(chan struct{})}
+				release := make(chan struct{})
+				if late {
+					observed.release = release
+				}
+				tunnel.table = observed
+				done := make(chan struct{})
+				var got *net.UDPConn
+				var err error
+				go func() { defer close(done); got, err = createOrGetLocalConn(remote, local, tunnel) }()
+				select {
+				case <-observed.observed:
+				case <-time.After(time.Second):
+					lock.L.Unlock()
+					if late {
+						close(release)
+					}
+					t.Fatal("waiter did not look up the creation lock")
+				}
+				if success && !table.AddForLocalConn(local.String(), remote.String(), conn, lock) {
+					lock.L.Unlock()
+					if late {
+						close(release)
+					}
+					t.Fatal("creator could not publish")
+				}
+				table.DeleteLockForLocalConn(local.String(), remote.String(), lock)
+				lock.L.Unlock()
+				if late {
+					close(release)
+				}
+				idleTestWait(t, done)
+				if success && (got != conn || err != nil) {
+					t.Fatal("waiter did not receive the published socket")
+				}
+				if !success && (got != nil || err == nil) {
+					t.Fatal("waiter did not receive the creation failure")
+				}
+			})
+		}
+	}
+}
+
+func TestServeLocalConnPreservesReplacementNATEntry(t *testing.T) {
+	conn, _ := idleTestPair(t)
+	replacement, _ := idleTestPair(t)
+	table, tunnel, local, remote := idleTestState(t, conn)
+	done := idleTestStart(t, conn, tunnel, local, remote, time.Second)
+	table.Delete(local.String())
+	table.GetOrCreate(local.String(), func() C.PacketSender { return nil })
+	table.AddForLocalConn(local.String(), remote.String(), replacement, nil)
+	conn.Close()
+	idleTestWait(t, done)
+	if table.GetForLocalConn(local.String(), remote.String()) != replacement {
+		t.Fatal("retired flow removed the replacement NAT entry's socket")
+	}
+}
+
+func TestWriteBackDoesNotRetryOtherErrors(t *testing.T) {
+	fresh, _ := idleTestPair(t)
+	table, tunnel, local, remote := idleTestState(t, fresh)
+	unconnected, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal("could not create unconnected socket")
+	}
+	defer unconnected.Close()
+	table.AddForLocalConn(local.String(), remote.String(), unconnected, nil)
+	observed := &replaceOnDeleteTable{NatTable: table, old: unconnected, replacement: fresh}
+	tunnel.table = observed
+	packet := &packet{lAddr: local, tunnel: tunnel}
+	_, err = packet.WriteBack([]byte("error"), net.UDPAddrFromAddrPort(remote))
+	if err == nil || errors.Is(err, net.ErrClosed) || observed.calls != 0 {
+		t.Fatal("an unrelated write failure triggered recreation")
+	}
+}
