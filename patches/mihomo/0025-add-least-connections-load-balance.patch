+package outboundgroup
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+	"github.com/stretchr/testify/require"
+)
+
+type leastTestProvider struct {
+	P.ProxyProvider
+	proxies []C.Proxy
+}
+
+func (p *leastTestProvider) Proxies() []C.Proxy { return p.proxies }
+func (*leastTestProvider) Version() uint32      { return 1 }
+func (*leastTestProvider) Touch()               {}
+
+type leastTestStream struct {
+	C.Conn
+	chains C.Chain
+}
+
+func (*leastTestStream) NeedHandshake() bool               { return false }
+func (*leastTestStream) Close() error                      { return nil }
+func (c *leastTestStream) AppendToChains(p C.ProxyAdapter) { c.chains = append(c.chains, p.Name()) }
+func (c *leastTestStream) Chains() C.Chain                 { return c.chains }
+
+type leastTestPacket struct {
+	C.PacketConn
+	chains C.Chain
+}
+
+func (*leastTestPacket) Close() error                      { return nil }
+func (c *leastTestPacket) AppendToChains(p C.ProxyAdapter) { c.chains = append(c.chains, p.Name()) }
+func (c *leastTestPacket) Chains() C.Chain                 { return c.chains }
+
+type leastTestProxy struct {
+	C.Proxy
+	name string
+	dial func() error
+}
+
+func (p *leastTestProxy) Name() string              { return p.name }
+func (*leastTestProxy) Type() C.AdapterType         { return C.Direct }
+func (*leastTestProxy) AliveForTestUrl(string) bool { return true }
+func (p *leastTestProxy) DialContext(context.Context, *C.Metadata) (C.Conn, error) {
+	if p.dial != nil {
+		if err := p.dial(); err != nil {
+			return nil, err
+		}
+	}
+	return &leastTestStream{chains: C.Chain{p.name}}, nil
+}
+func (p *leastTestProxy) ListenPacketContext(context.Context, *C.Metadata) (C.PacketConn, error) {
+	if p.dial != nil {
+		if err := p.dial(); err != nil {
+			return nil, err
+		}
+	}
+	return &leastTestPacket{chains: C.Chain{p.name}}, nil
+}
+
+func leastTestGroup(t *testing.T, proxies ...C.Proxy) *LoadBalance {
+	t.Helper()
+	provider := &leastTestProvider{proxies: proxies}
+	lb, err := NewLoadBalance(GroupCommonOption{Name: "least-test"},
+		LoadBalanceOption{Strategy: "least-connections"}, proxies[0], []P.ProxyProvider{provider})
+	require.NoError(t, err)
+	return lb
+}
+
+type leastTestConnection interface {
+	Close() error
+	Chains() C.Chain
+}
+
+func leastTestDial(lb *LoadBalance, network string) (leastTestConnection, error) {
+	if network == "tcp" {
+		return lb.DialContext(context.Background(), &C.Metadata{})
+	}
+	return lb.ListenPacketContext(context.Background(), &C.Metadata{})
+}
+
+func leastTestOpen(t *testing.T, lb *LoadBalance, network, want string) leastTestConnection {
+	t.Helper()
+	conn, err := leastTestDial(lb, network)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+	require.Equal(t, C.Chain{want, "least-test"}, conn.Chains())
+	return conn
+}
+
+func TestLoadBalanceLeastConnectionsDialLifecycle(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		for _, outcome := range []string{"success", "failure"} {
+			t.Run(network+"/"+outcome, func(t *testing.T) {
+				members := []C.Proxy{&leastTestProxy{name: "a"}, &leastTestProxy{name: "b"}, &leastTestProxy{name: "c"}}
+				lb := leastTestGroup(t, members...)
+				leastTestOpen(t, lb, network, "a")
+				leastTestOpen(t, lb, network, "b")
+				old := leastTestOpen(t, lb, network, "c")
+				require.NoError(t, old.Close())
+				// Only c is now free. Neither a successful dial nor a failed one
+				// gets a lifetime membership in the active counters.
+				if outcome == "failure" {
+					members[2].(*leastTestProxy).dial = func() error { return C.ErrNotSupport }
+					_, err := leastTestDial(lb, network)
+					require.ErrorIs(t, err, C.ErrNotSupport)
+					members[2].(*leastTestProxy).dial = nil
+				}
+				leastTestOpen(t, lb, network, "c")
+				if outcome == "success" {
+					require.NoError(t, old.Close())
+					// A duplicate close must not release the replacement connection.
+					leastTestOpen(t, lb, network, "b")
+				}
+			})
+		}
+	}
+}
+
+func TestLoadBalanceLeastConnectionsReservesBeforeDialCompletes(t *testing.T) {
+	for _, network := range []string{"tcp", "udp"} {
+		t.Run(network, func(t *testing.T) {
+			a, b, c := &leastTestProxy{name: "a"}, &leastTestProxy{name: "b"}, &leastTestProxy{name: "c"}
+			lb := leastTestGroup(t, a, b, c)
+			leastTestOpen(t, lb, network, "a")
+			leastTestOpen(t, lb, network, "b")
+			require.NoError(t, leastTestOpen(t, lb, network, "c").Close())
+			block := make(chan struct{}, 1)
+			block <- struct{}{}
+			started, unblock := make(chan struct{}), make(chan struct{})
+			c.dial = func() error {
+				select {
+				case <-block:
+					close(started)
+					<-unblock
+				default:
+				}
+				return nil
+			}
+			type result struct {
+				conn leastTestConnection
+				err  error
+			}
+			done := make(chan result, 1)
+			t.Cleanup(func() {
+				close(unblock)
+				select {
+				case r := <-done:
+					if r.err != nil {
+						t.Error(r.err)
+					}
+					if r.conn != nil {
+						_ = r.conn.Close()
+					}
+				case <-time.After(2 * time.Second):
+					t.Error("blocked dial did not finish")
+				}
+			})
+			go func() { conn, err := leastTestDial(lb, network); done <- result{conn, err} }()
+			select {
+			case <-started:
+			case <-time.After(2 * time.Second):
+				t.Fatal("dial did not start")
+			}
+			// The pending c dial is already counted. Equal counts rotate to b.
+			leastTestOpen(t, lb, network, "b")
+		})
+	}
+}
+
+func TestLoadBalanceLeastConnectionsUnwrapDoesNotReserve(t *testing.T) {
+	members := []C.Proxy{&leastTestProxy{name: "a"}, &leastTestProxy{name: "b"}}
+	lb := leastTestGroup(t, members...)
+	for i := 0; i < 10; i++ {
+		require.Same(t, members[0], lb.Unwrap(&C.Metadata{}, i%2 == 0))
+	}
+	leastTestOpen(t, lb, "tcp", "a")
+	for i := 0; i < 10; i++ {
+		require.Same(t, members[1], lb.Unwrap(&C.Metadata{}, i%2 == 0))
+	}
+	leastTestOpen(t, lb, "udp", "b")
+}
+
+func TestLoadBalanceLeastConnectionsClosureIsPerGroup(t *testing.T) {
+	proxies := balancedProxies(2)
+	first, second := strategyLeastConnections(testUrl), strategyLeastConnections(testUrl)
+	picked, release := first(proxies, &C.Metadata{}, true, true)
+	require.Same(t, proxies[0], picked)
+	t.Cleanup(release)
+	picked, release = second(proxies, &C.Metadata{}, true, true)
+	require.Same(t, proxies[0], picked, "a second group must not inherit the first group's counters")
+	t.Cleanup(release)
+	picked, release = first(proxies, &C.Metadata{}, true, true)
+	require.Same(t, proxies[1], picked, "calls to the same closure must share its counters")
+	t.Cleanup(release)
+}
