+func TestLoadBalanceLeastConnectionsConcurrentReservations(t *testing.T) {
+	proxies := balancedProxies(3)
+	lc := newLeastConnections()
+	type reservation struct {
+		proxy   C.Proxy
+		release func()
+	}
+	held := make(chan reservation, 48)
+	var wg sync.WaitGroup
+	for i := 0; i < cap(held); i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			proxy, release := lc.pick(proxies, testUrl, true)
+			held <- reservation{proxy, release}
+		}()
+	}
+	wg.Wait()
+	close(held)
+	counts := map[C.Proxy]int{}
+	var releases []func()
+	for reservation := range held {
+		counts[reservation.proxy]++
+		releases = append(releases, reservation.release)
+	}
+	for _, proxy := range proxies {
+		require.Equal(t, 16, counts[proxy])
+	}
+	// Concurrent duplicate closes must still release every reservation once.
+	for _, release := range releases {
+		for i := 0; i < 2; i++ {
+			wg.Add(1)
+			go func(release func()) { defer wg.Done(); release() }(release)
+		}
+	}
+	wg.Wait()
+	require.Empty(t, lc.active)
+}
