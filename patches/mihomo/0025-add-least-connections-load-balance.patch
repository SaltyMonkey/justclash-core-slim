+func TestLoadBalanceLeastConnectionsMemberReplacement(t *testing.T) {
+	lc := newLeastConnections()
+	old, replacement := balancedProxies(1)[0], balancedProxies(1)[0]
+	_, releaseOld := lc.pick([]C.Proxy{old}, testUrl, true)
+	selected, releaseNew := lc.pick([]C.Proxy{replacement}, testUrl, true)
+	require.Same(t, replacement, selected)
+	releaseOld()
+	require.Equal(t, map[C.Proxy]int{replacement: 1}, lc.active)
+	releaseNew()
+	require.Empty(t, lc.active)
+}
