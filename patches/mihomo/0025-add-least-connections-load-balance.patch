+func TestLoadBalanceOtherStrategiesNeedNoRelease(t *testing.T) {
+	for _, name := range []string{"round-robin", "consistent-hashing", "sticky-sessions"} {
+		t.Run(name, func(t *testing.T) {
+			members := []C.Proxy{&leastTestProxy{name: "a"}, &leastTestProxy{name: "b"}}
+			provider := &leastTestProvider{proxies: members}
+			lb, err := NewLoadBalance(GroupCommonOption{Name: "least-test"}, LoadBalanceOption{Strategy: name}, members[0], []P.ProxyProvider{provider})
+			require.NoError(t, err)
+			for _, touch := range []bool{false, true} {
+				for _, acquire := range []bool{false, true} {
+					_, release := lb.strategyFn(members, &C.Metadata{}, touch, acquire)
+					require.Nil(t, release)
+				}
+			}
+			for _, network := range []string{"tcp", "udp"} {
+				conn, err := leastTestDial(lb, network)
+				require.NoError(t, err)
+				switch network {
+				case "tcp":
+					require.IsType(t, &leastTestStream{}, conn)
+				case "udp":
+					require.IsType(t, &leastTestPacket{}, conn)
+				}
+				require.NoError(t, conn.Close())
+			}
+			for _, member := range members {
+				member.(*leastTestProxy).dial = func() error { return C.ErrNotSupport }
+			}
+			for _, network := range []string{"tcp", "udp"} {
+				_, err := leastTestDial(lb, network)
+				require.ErrorIs(t, err, C.ErrNotSupport)
+			}
+		})
+	}
+}
