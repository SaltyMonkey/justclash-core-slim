+++ b/adapter/outboundgroup/fallback_test.go
@@ -0,0 +1,69 @@
+package outboundgroup
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/adapter/provider"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+
+	"github.com/stretchr/testify/require"
+)
+
+// newTestFallback builds a fallback group whose first member is dead and second alive for url.
+func newTestFallback(t *testing.T, url string) *Fallback {
+	t.Helper()
+	dead, err := adapter.ParseProxy(map[string]any{"name": "dead", "type": "socks5", "server": "127.0.0.1", "port": 1})
+	require.NoError(t, err)
+	alive := adapter.NewProxy(outbound.NewDirectWithOption(outbound.DirectOption{Name: "alive"}))
+	proxies := []C.Proxy{dead, alive}
+	for _, proxy := range proxies {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		_, _ = proxy.URLTest(ctx, url, nil)
+		cancel()
+	}
+	require.False(t, dead.AliveForTestUrl(url))
+	require.True(t, alive.AliveForTestUrl(url))
+
+	pd, err := provider.NewCompatibleProvider("fallback-test", proxies, provider.NewHealthCheck(proxies, "", 0, 0, true, nil))
+	require.NoError(t, err)
+	group, err := NewFallback(GroupCommonOption{Name: "fallback", URL: url}, FallbackOption{}, adapter.NewProxy(outbound.NewCompatible()), []P.ProxyProvider{pd})
+	require.NoError(t, err)
+	return group
+}
+
+// A selected proxy the group does not have -- renamed or removed by a provider update, restored
+// by store-selected under a name the group no longer lists, or in a provider that has not loaded
+// yet -- is passed over: the group picks its first alive proxy, as if nothing were selected, and
+// keeps the selection for when a provider lists the proxy.
+func TestFallbackSelectedProxyNotInGroup(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+
+	group := newTestFallback(t, server.URL)
+	group.ForceSet("renamed")
+	require.Equal(t, "alive", group.Now())
+	require.Equal(t, "renamed", group.selected)
+	require.Equal(t, "alive", group.findAliveProxy(true).Name())
+}
+
+// A selected proxy the group has is still used while it is alive.
+func TestFallbackSelectedProxyInGroup(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+
+	group := newTestFallback(t, server.URL)
+	group.ForceSet("alive")
+	require.Equal(t, "alive", group.Now())
+	require.Equal(t, "alive", group.selected)
+}
diff --git a/adapter/outboundgroup/fallback_state_test.go b/adapter/outboundgroup/fallback_state_test.go
new file mode 100644
--- /dev/null
+++ b/adapter/outboundgroup/fallback_state_test.go
@@ -0,0 +1,88 @@
+package outboundgroup
+
+import (
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+type fallbackStateProxy struct {
+	C.Proxy
+	name  string
+	alive bool
+}
+
+func (p *fallbackStateProxy) Name() string                { return p.name }
+func (p *fallbackStateProxy) AliveForTestUrl(string) bool { return p.alive }
+
+type fallbackStateProvider struct {
+	P.ProxyProvider
+	proxies []C.Proxy
+	version uint32
+}
+
+func (p *fallbackStateProvider) Proxies() []C.Proxy { return p.proxies }
+func (p *fallbackStateProvider) Version() uint32    { return p.version }
+func (p *fallbackStateProvider) Touch()             {}
+
+func newFallbackStateTestGroup(t *testing.T, proxies []C.Proxy) (*Fallback, *fallbackStateProvider) {
+	t.Helper()
+	provider := &fallbackStateProvider{proxies: proxies, version: 1}
+	empty := &fallbackStateProxy{name: "empty", alive: true}
+	group, err := NewFallback(GroupCommonOption{Name: "fallback-state-test"}, FallbackOption{}, empty, []P.ProxyProvider{provider})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return group, provider
+}
+
+func TestFallbackSelectionTransitions(t *testing.T) {
+	first := &fallbackStateProxy{name: "first", alive: true}
+	chosen := &fallbackStateProxy{name: "chosen", alive: true}
+	dead := &fallbackStateProxy{name: "dead", alive: false}
+	t.Run("present-selection-beats-earlier-alive", func(t *testing.T) {
+		group, _ := newFallbackStateTestGroup(t, []C.Proxy{first, chosen})
+		group.ForceSet("chosen")
+		if group.Now() != "chosen" {
+			t.Fatal("live manual selection lost")
+		}
+	})
+	t.Run("removed-selection-returns-with-provider", func(t *testing.T) {
+		group, provider := newFallbackStateTestGroup(t, []C.Proxy{first, chosen})
+		group.ForceSet("chosen")
+		if group.Now() != "chosen" {
+			t.Fatal("initial selection lost")
+		}
+		provider.proxies = []C.Proxy{dead, first}
+		provider.version++
+		if group.Now() != "first" || group.selected != "chosen" {
+			t.Fatal("missing selection did not fall back while retaining preference")
+		}
+		provider.proxies = []C.Proxy{first, chosen}
+		provider.version++
+		if group.Now() != "chosen" {
+			t.Fatal("restored selection not used")
+		}
+	})
+	t.Run("missing-selection-all-dead", func(t *testing.T) {
+		group, _ := newFallbackStateTestGroup(t, []C.Proxy{dead, &fallbackStateProxy{name: "other", alive: false}})
+		group.ForceSet("missing")
+		if group.Now() != "dead" || group.selected != "missing" {
+			t.Fatal("all-dead fallback behavior changed")
+		}
+	})
+	t.Run("missing-selection-empty-provider", func(t *testing.T) {
+		group, _ := newFallbackStateTestGroup(t, nil)
+		group.ForceSet("chosen")
+		if group.Now() != "empty" || group.selected != "chosen" {
+			t.Fatal("empty provider fallback broken")
+		}
+	})
+	t.Run("no-selection-first-alive", func(t *testing.T) {
+		group, _ := newFallbackStateTestGroup(t, []C.Proxy{dead, first})
+		if group.Now() != "first" {
+			t.Fatal("default alive ordering changed")
+		}
+	})
+}
