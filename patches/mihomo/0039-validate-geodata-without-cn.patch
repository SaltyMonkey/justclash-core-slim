index 0000000..c1e56c2
--- /dev/null
+++ b/component/updater/update_geodata_verify_test.go
@@ -0,0 +1,107 @@
+package updater
+
+import (
+	"bytes"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"sync/atomic"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/geodata"
+	"github.com/metacubex/mihomo/component/geodata/router"
+	C "github.com/metacubex/mihomo/constant"
+
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestGeoDataUpdateWithoutCN(t *testing.T) {
+	previousHome := C.Path.HomeDir()
+	t.Cleanup(func() { C.SetHomeDir(previousHome) })
+	C.SetHomeDir(t.TempDir())
+
+	for _, tc := range []struct {
+		name   string
+		path   func() string
+		url    func() string
+		setURL func(string)
+		update func() error
+		list   func(string) proto.Message
+	}{
+		{
+			name: C.GeositeName, path: C.Path.GeoSite, url: geodata.GeoSiteUrl,
+			setURL: geodata.SetGeoSiteUrl, update: UpdateGeoSite,
+			list: func(category string) proto.Message {
+				return &router.GeoSiteList{Entry: []*router.GeoSite{{CountryCode: category}}}
+			},
+		},
+		{
+			name: C.GeoipName, path: C.Path.GeoIP, url: geodata.GeoIpUrl,
+			setURL: geodata.SetGeoIpUrl, update: UpdateGeoIp,
+			list: func(category string) proto.Message {
+				return &router.GeoIPList{Entry: []*router.GeoIP{{CountryCode: category}}}
+			},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			previous, err := proto.Marshal(tc.list("PREVIOUS"))
+			if err != nil {
+				t.Fatal("cannot encode existing database")
+			}
+			replacement, err := proto.Marshal(tc.list("CUSTOM"))
+			if err != nil {
+				t.Fatal("cannot encode replacement database")
+			}
+			truncated := replacement[:len(replacement)-1]
+			path := tc.path()
+			if err := os.WriteFile(path, truncated, 0600); err != nil {
+				t.Fatal("cannot create truncated database")
+			}
+			if err := geodata.Verify(tc.name); err == nil {
+				t.Fatal("startup verification accepted a truncated file")
+			}
+			if err := os.WriteFile(path, previous, 0600); err != nil {
+				t.Fatal("cannot create existing database")
+			}
+			if err := geodata.Verify(tc.name); err != nil {
+				t.Fatal("startup verification rejected a custom database without CN")
+			}
+
+			// The outer record is complete, but its embedded protobuf is truncated.
+			invalidEntry := protowire.AppendBytes(protowire.AppendTag(nil, 1, protowire.BytesType), []byte{0x0a})
+			emptyEntry := protowire.AppendBytes(protowire.AppendTag(bytes.Clone(replacement), 1, protowire.BytesType), nil)
+			bodies := [][]byte{truncated, invalidEntry, emptyEntry, replacement}
+			var requests atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				index := int(requests.Add(1)) - 1
+				if index >= len(bodies) {
+					w.WriteHeader(http.StatusInternalServerError)
+					return
+				}
+				_, _ = w.Write(bodies[index])
+			}))
+			t.Cleanup(server.Close)
+			previousURL := tc.url()
+			t.Cleanup(func() { tc.setURL(previousURL) })
+			tc.setURL(server.URL)
+
+			for _, reason := range []string{"truncated file", "invalid entry", "empty entry"} {
+				if err := tc.update(); err == nil {
+					t.Fatalf("update accepted a database with %s", reason)
+				}
+				saved, err := os.ReadFile(path)
+				if err != nil || !bytes.Equal(saved, previous) {
+					t.Fatalf("a database with %s replaced the existing file", reason)
+				}
+			}
+			if err := tc.update(); err != nil {
+				t.Fatalf("update rejected a database without CN: %T", err)
+			}
+			saved, err := os.ReadFile(path)
+			if err != nil || !bytes.Equal(saved, replacement) {
+				t.Fatal("valid custom database was not installed")
+			}
+		})
+	}
+}
