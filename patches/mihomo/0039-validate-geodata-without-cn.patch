index 0000000..639babf
--- /dev/null
+++ b/component/geodata/verify.go
@@ -0,0 +1,71 @@
+package geodata
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"math"
+	"os"
+
+	"github.com/metacubex/mihomo/component/geodata/router"
+	C "github.com/metacubex/mihomo/constant"
+
+	"google.golang.org/protobuf/proto"
+)
+
+func verifyGeodataFile(path string) error {
+	file, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	return verifyGeodataReader(file)
+}
+
+func verifyGeodataReader(source io.Reader) error {
+	reader := bufio.NewReader(source)
+	hasEntry := false
+	for {
+		tag, err := reader.ReadByte()
+		if err == io.EOF && hasEntry {
+			return nil
+		}
+		if err != nil {
+			return fmt.Errorf("cannot read geodata entry: %w", err)
+		}
+		// GeoIPList and GeoSiteList both store entries as length-delimited field 1.
+		if tag != 0x0a {
+			return fmt.Errorf("unexpected geodata entry tag 0x%02x", tag)
+		}
+
+		size, err := binary.ReadUvarint(reader)
+		if err != nil {
+			return fmt.Errorf("cannot read geodata entry length: %w", err)
+		}
+		if size == 0 || size > math.MaxInt64 {
+			return fmt.Errorf("invalid geodata entry length %d", size)
+		}
+		if _, err := io.CopyN(io.Discard, reader, int64(size)); err != nil {
+			return fmt.Errorf("truncated geodata entry: %w", err)
+		}
+		hasEntry = true
+	}
+}
+
+// VerifyGeodataBytes checks the complete protobuf, including the contents of
+// each entry, before a download replaces the current database.
+func VerifyGeodataBytes(name string, data []byte) error {
+	if err := verifyGeodataReader(bytes.NewReader(data)); err != nil {
+		return err
+	}
+	switch name {
+	case C.GeositeName:
+		return proto.Unmarshal(data, &router.GeoSiteList{})
+	case C.GeoipName:
+		return proto.Unmarshal(data, &router.GeoIPList{})
+	default:
+		return fmt.Errorf("unsupported geodata name %q", name)
+	}
+}
