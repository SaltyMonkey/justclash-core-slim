diff --git a/log/log.go b/log/log.go
index 1fa59c6..04bb574 100644
--- a/log/log.go
+++ b/log/log.go
@@ -46,6 +46,13 @@ func Infoln(format string, v ...any) {
 	print(event)
 }
 
+// StartupInfoln prints startup status at INFO regardless of the configured level.
+func StartupInfoln(format string, v ...any) {
+	event := newLog(INFO, format, v...)
+	logCh <- event
+	log.Infoln(event.Payload)
+}
+
 func Warnln(format string, v ...any) {
 	event := newLog(WARNING, format, v...)
 	logCh <- event
diff --git a/log/startup_test.go b/log/startup_test.go
new file mode 100644
index 0000000..bf43c6d
--- /dev/null
+++ b/log/startup_test.go
@@ -0,0 +1,32 @@
+package log
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/sirupsen/logrus"
+)
+
+func TestStartupInfolnIgnoresTerminalThreshold(t *testing.T) {
+	previousLevel := Level()
+	previousOutput := logrus.StandardLogger().Out
+	t.Cleanup(func() {
+		SetLevel(previousLevel)
+		logrus.SetOutput(previousOutput)
+	})
+
+	for _, level := range []LogLevel{ERROR, SILENT} {
+		t.Run(level.String(), func(t *testing.T) {
+			var output bytes.Buffer
+			logrus.SetOutput(&output)
+			SetLevel(level)
+
+			Infoln("ordinary info")
+			StartupInfoln("startup status %d", 7)
+			if text := output.String(); strings.Count(text, "startup status 7") != 1 || strings.Contains(text, "ordinary info") {
+				t.Fatalf("unexpected terminal log: %q", text)
+			}
+		})
+	}
+}
