diff --git a/adapter/outbound/hysteria_disabled_test.go b/adapter/outbound/hysteria_disabled_test.go
new file mode 100644
--- /dev/null
+++ b/adapter/outbound/hysteria_disabled_test.go
@@ -0,0 +1,21 @@
+//go:build no_hysteria1
+
+package outbound_test
+
+import (
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"strings"
+	"testing"
+)
+
+func TestSlimHysteriaDisabled(t *testing.T) {
+	proxy, err := outbound.NewHysteria(outbound.HysteriaOption{})
+	if proxy != nil || err == nil || !strings.Contains(err.Error(), "disabled in slim builds") {
+		t.Fatal("disabled outbound must reject configuration before creating resources")
+	}
+	parsed, err := adapter.ParseProxy(map[string]any{"name": "disabled-test", "type": "hysteria", "server": "", "port": 0, "password": "", "cipher": "", "obfs": "", "protocol": "", "up": "", "down": "", "ca": "", "psk": ""})
+	if parsed != nil || err == nil || !strings.Contains(err.Error(), "disabled in slim builds") {
+		t.Fatalf("proxy parser must report a disabled protocol: %v", err)
+	}
+}
diff --git a/adapter/outbound/hysteria_stub.go b/adapter/outbound/hysteria_stub.go
new file mode 100644
--- /dev/null
+++ b/adapter/outbound/hysteria_stub.go
@@ -0,0 +1,42 @@
+//go:build no_hysteria1
+
+package outbound
+
+import "errors"
+
+// Keep decoding intact; disabled protocols do not need a mystery error tour.
+type Hysteria struct{ *Base }
+type HysteriaOption struct {
+	BasicOption
+	Name                string     `proxy:"name"`
+	Server              string     `proxy:"server"`
+	Port                int        `proxy:"port,omitempty"`
+	Ports               string     `proxy:"ports,omitempty"`
+	Protocol            string     `proxy:"protocol,omitempty"`
+	ObfsProtocol        string     `proxy:"obfs-protocol,omitempty"` // compatible with Stash
+	Up                  string     `proxy:"up"`
+	UpSpeed             int        `proxy:"up-speed,omitempty"` // compatible with Stash
+	Down                string     `proxy:"down"`
+	DownSpeed           int        `proxy:"down-speed,omitempty"` // compatible with Stash
+	Auth                string     `proxy:"auth,omitempty"`
+	AuthString          string     `proxy:"auth-str,omitempty"`
+	Obfs                string     `proxy:"obfs,omitempty"`
+	SNI                 string     `proxy:"sni,omitempty"`
+	ECHOpts             ECHOptions `proxy:"ech-opts,omitempty"`
+	SkipCertVerify      bool       `proxy:"skip-cert-verify,omitempty"`
+	NameCertVerify      string     `proxy:"name-cert-verify,omitempty"`
+	Fingerprint         string     `proxy:"fingerprint,omitempty"`
+	Certificate         string     `proxy:"certificate,omitempty"`
+	PrivateKey          string     `proxy:"private-key,omitempty"`
+	ALPN                []string   `proxy:"alpn,omitempty"`
+	ReceiveWindowConn   int        `proxy:"recv-window-conn,omitempty"`
+	ReceiveWindow       int        `proxy:"recv-window,omitempty"`
+	DisableMTUDiscovery bool       `proxy:"disable-mtu-discovery,omitempty"`
+	FastOpen            bool       `proxy:"fast-open,omitempty"`
+	HopInterval         int        `proxy:"hop-interval,omitempty"`
+}
+
+func NewHysteria(option HysteriaOption) (*Hysteria, error) {
+	return nil, errors.New("Hysteria support is disabled in slim builds")
+}
+var _ ProxyAdapter = (*Hysteria)(nil)
