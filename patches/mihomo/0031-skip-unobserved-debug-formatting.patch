diff --git a/log/debug_interest_test.go b/log/debug_interest_test.go
new file mode 100644
index 0000000000..290cf1225a
--- /dev/null
+++ b/log/debug_interest_test.go
@@ -0,0 +1,88 @@
+package log
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type debugStringer struct{ calls *atomic.Int64 }
+
+func (s debugStringer) String() string { s.calls.Add(1); return "formatted" }
+
+func TestDebugInterest(t *testing.T) {
+	old := Level()
+	SetLevel(INFO)
+	defer SetLevel(old)
+	calls := new(atomic.Int64)
+	value := debugStringer{calls}
+	Debugln("%s", value)
+	SingLogger.Debug(value)
+	SingInfoToDebugLogger.Info(value)
+	if calls.Load() != 0 || DebugEnabled() {
+		t.Fatal("unused DEBUG was formatted")
+	}
+	info := SubscribeLevel(INFO)
+	defer UnSubscribe(info)
+	Debugln("%s", value)
+	if calls.Load() != 0 || DebugEnabled() {
+		t.Fatal("INFO subscription enabled DEBUG")
+	}
+	debug := Subscribe()
+	defer UnSubscribe(debug)
+	Debugln("%s", value)
+	select {
+	case event := <-debug:
+		if event.Payload != "formatted" || event.LogLevel != DEBUG {
+			t.Fatal(event)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("DEBUG subscriber lost event")
+	}
+	if calls.Load() != 1 {
+		t.Fatal("DEBUG payload not formatted once", calls.Load())
+	}
+	SetLevel(DEBUG)
+	UnSubscribe(debug)
+	UnSubscribe(debug)
+	if !DebugEnabled() {
+		t.Fatal("terminal DEBUG lost interest during handoff")
+	}
+	SetLevel(INFO)
+	if DebugEnabled() {
+		t.Fatal("last DEBUG interest retained")
+	}
+	UnSubscribe(info)
+}
+
+func TestDebugInterestConcurrent(t *testing.T) {
+	old := Level()
+	SetLevel(DEBUG)
+	defer SetLevel(old)
+	// Each writer transfers interest with overlap. There is continuously at least
+	// one receiver; the aggregate guard must never briefly publish false.
+	var wg sync.WaitGroup
+	var stop atomic.Bool
+	var missing atomic.Bool
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for !stop.Load() {
+			if !DebugEnabled() {
+				missing.Store(true)
+			}
+		}
+	}()
+	for i := 0; i < 1000; i++ {
+		sub := SubscribeLevel(DEBUG)
+		SetLevel(INFO)
+		SetLevel(DEBUG)
+		UnSubscribe(sub)
+	}
+	stop.Store(true)
+	wg.Wait()
+	if missing.Load() {
+		t.Fatal("DEBUG interest vanished during an overlapping handoff")
+	}
+}
diff --git a/log/debug_slow_test.go b/log/debug_slow_test.go
new file mode 100644
index 0000000000..761a4637fd
--- /dev/null
+++ b/log/debug_slow_test.go
@@ -0,0 +1,94 @@
+package log
+
+import (
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestLevelChangeWithSaturatedSubscriber(t *testing.T) {
+	old := Level()
+	SetLevel(ERROR)
+	sub := Subscribe()
+	producerDone, unsubDone := make(chan struct{}), make(chan struct{})
+	var changed chan struct{}
+	unsubStarted := false
+	wait := func(ch <-chan struct{}, name string) {
+		select {
+		case <-ch:
+		case <-time.After(time.Second):
+			t.Error(name + " did not settle")
+		}
+	}
+	// Draining is required by the existing blocking observable contract. Wait
+	// for every writer before restoring the package's global level, even on failure.
+	defer func() {
+		go func() {
+			for range sub {
+			}
+		}()
+		if !unsubStarted {
+			go func() { UnSubscribe(sub); close(unsubDone) }()
+		}
+		wait(producerDone, "producer")
+		wait(unsubDone, "unsubscribe")
+		if changed != nil {
+			wait(changed, "level writer")
+		}
+		SetLevel(old)
+	}()
+	for i := 0; i < cap(sub); i++ {
+		Infoln("fill")
+	}
+	first := make(chan struct{})
+	go func() { Infoln("overflow"); close(first); Infoln("pending"); close(producerDone) }()
+	select {
+	case <-first:
+	case <-time.After(time.Second):
+		t.Fatal("overflow not received")
+	}
+	// Receiving the overflow event alone does not prove process has acquired its
+	// mutex. Observe the actual blocked broadcast before starting the unregister.
+	// There is one observable in this package; process sends only inside Emit.
+	deadline := time.Now().Add(time.Second)
+	blocked := false
+	for time.Now().Before(deadline) {
+		buffer := make([]byte, 64<<10)
+		n := runtime.Stack(buffer, true)
+		for _, stack := range strings.Split(string(buffer[:n]), "\n\n") {
+			if strings.Contains(stack, "[chan send]") && strings.Contains(stack, "common/observable.(*Observable[") && strings.Contains(stack, ").process(") {
+				blocked = true
+				break
+			}
+		}
+		if blocked {
+			break
+		}
+		runtime.Gosched()
+	}
+	if !blocked {
+		t.Fatal("did not reach blocked observable delivery")
+	}
+	unsubStarted = true
+	go func() { UnSubscribe(sub); close(unsubDone) }()
+	deadline = time.Now().Add(time.Second)
+	for DebugEnabled() && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if DebugEnabled() {
+		t.Fatal("unsubscribe did not withdraw interest")
+	}
+	select {
+	case <-unsubDone:
+		t.Fatal("unsubscribe unexpectedly bypassed blocked delivery")
+	default:
+	}
+	changed = make(chan struct{})
+	go func() { SetLevel(DEBUG); close(changed) }()
+	select {
+	case <-changed:
+	case <-time.After(time.Second):
+		t.Fatal("observable backpressure held the level writer lock")
+	}
+}
