+package xhttp
+
+import (
+	"io"
+	"net"
+	"testing"
+
+	"github.com/metacubex/http"
+	"github.com/metacubex/http/httptest"
+	"github.com/stretchr/testify/require"
+)
+
+func TestXHTTPZeroRangesUseDefaults(t *testing.T) {
+	tests := []struct {
+		name string
+		read func(*Config) (Range, error)
+		want Range
+	}{
+		{"padding", (*Config).GetNormalizedXPaddingBytes, Range{100, 1000}},
+		{"stream_up_interval", (*Config).GetNormalizedScStreamUpServerSecs, Range{20, 80}},
+		{"buffered_posts", (*Config).GetNormalizedScMaxBufferedPosts, Range{30, 30}},
+		{"post_bytes", (*Config).GetNormalizedScMaxEachPostBytes, Range{1000000, 1000000}},
+		{"post_interval", (*Config).GetNormalizedScMinPostsIntervalMs, Range{30, 30}},
+	}
+	config := func(value string) *Config {
+		return &Config{XPaddingBytes: value, ScStreamUpServerSecs: value,
+			ScMaxBufferedPosts: value, ScMaxEachPostBytes: value, ScMinPostsIntervalMs: value}
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, value := range []string{"", "0", "0-0"} {
+				got, err := tc.read(config(value))
+				require.NoError(t, err)
+				require.Equal(t, tc.want, got, value)
+			}
+			got, err := tc.read(config("2-4"))
+			require.NoError(t, err)
+			require.Equal(t, Range{2, 4}, got, "explicit ranges remain authoritative")
+			for _, value := range []string{"bad", "-1", "4-2"} {
+				_, err := tc.read(config(value))
+				require.Error(t, err, value)
+			}
+		})
+	}
+	_, err := (&Config{ScMaxEachPostBytes: "0-1024"}).GetNormalizedScMaxEachPostBytes()
+	require.Error(t, err, "a zero-sized upload block makes very little progress")
+}
+
+func TestXHTTPZeroPaddingAcceptedByServer(t *testing.T) {
+	for _, mode := range []string{"stream-one", "packet-up"} {
+		for _, serverPadding := range []string{"", "0", "0-0"} {
+			for _, clientPadding := range []string{"0", "0-0"} {
+				t.Run(mode+"/server="+serverPadding+"/client="+clientPadding, func(t *testing.T) {
+					serverConfig := Config{Path: "/xhttp", Mode: mode, XPaddingBytes: serverPadding}
+					handler, err := NewServerHandler(ServerOption{
+						Config:      serverConfig,
+						ConnHandler: func(conn net.Conn) { _ = conn.Close() },
+					})
+					require.NoError(t, err)
+					clientConfig := serverConfig
+					clientConfig.XPaddingBytes = clientPadding
+					method, target := http.MethodPost, "https://xhttp.invalid/xhttp/"
+					if mode == "packet-up" {
+						method, target = http.MethodGet, "https://xhttp.invalid/xhttp/session"
+					}
+					req := httptest.NewRequest(method, target, io.NopCloser(http.NoBody))
+					require.NoError(t, clientConfig.FillStreamRequest(req, ""))
+					recorder := httptest.NewRecorder()
+					handler.ServeHTTP(recorder, req)
+					require.Equal(t, http.StatusOK, recorder.Result().StatusCode)
+				})
+			}
+		}
+	}
+}
+
+func TestXHTTPReuseZeroKeepsItsMeaning(t *testing.T) {
+	for _, value := range []string{"0", "0-0"} {
+		config := &ReuseConfig{MaxConnections: value, MaxConcurrency: value,
+			CMaxReuseTimes: value, HMaxRequestTimes: value, HMaxReusableSecs: value}
+		concurrency, connections, err := config.ResolveManagerConfig()
+		require.NoError(t, err)
+		require.Equal(t, Range{}, concurrency)
+		require.Equal(t, Range{}, connections)
+		reuse, requests, seconds, err := config.ResolveEntryConfig()
+		require.NoError(t, err)
+		require.Equal(t, Range{}, reuse)
+		require.Equal(t, Range{}, requests)
+		require.Equal(t, Range{}, seconds)
+	}
+}
