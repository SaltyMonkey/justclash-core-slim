+package route
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/common/utils"
+	C "github.com/metacubex/mihomo/constant"
+
+	"github.com/metacubex/http"
+	"github.com/metacubex/http/httptest"
+)
+
+type requestDelayProxy struct {
+	C.Proxy
+	started  chan context.Context
+	finished chan error
+}
+
+func (p *requestDelayProxy) URLTest(ctx context.Context, _ string, _ utils.IntRanges[uint16]) (uint16, error) {
+	p.started <- ctx
+	<-ctx.Done()
+	p.finished <- ctx.Err()
+	return 0, ctx.Err()
+}
+
+func TestGetProxyDelayRequestContext(t *testing.T) {
+	for _, mode := range []string{"cancelled_request", "earlier_request_deadline", "query_timeout"} {
+		t.Run(mode, func(t *testing.T) {
+			proxy := &requestDelayProxy{started: make(chan context.Context, 1), finished: make(chan error, 1)}
+			parent, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			timeout := "8000"
+			if mode == "query_timeout" {
+				timeout = "50"
+			}
+			if mode == "earlier_request_deadline" {
+				var deadlineCancel context.CancelFunc
+				parent, deadlineCancel = context.WithTimeout(parent, 50*time.Millisecond)
+				defer deadlineCancel()
+			}
+			req := httptest.NewRequest(http.MethodGet, "/proxies/test/delay?timeout="+timeout, nil)
+			req = req.WithContext(context.WithValue(parent, CtxKeyProxy, C.Proxy(proxy)))
+			recorder := httptest.NewRecorder()
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				getProxyDelay(recorder, req)
+			}()
+			var child context.Context
+			select {
+			case child = <-proxy.started:
+			case <-time.After(2 * time.Second):
+				t.Fatal("delay test did not start")
+			}
+			// Cap cleanup even when checking the old Background-based implementation.
+			t.Cleanup(func() {
+				// The query timeout is the final fallback for a broken implementation.
+				select {
+				case <-done:
+				case <-time.After(9 * time.Second):
+					t.Error("delay handler leaked")
+				}
+			})
+			if mode == "cancelled_request" {
+				cancel()
+			}
+			select {
+			case <-done:
+			case <-time.After(2 * time.Second):
+				t.Fatal("delay test ignored request cancellation or its deadline")
+			}
+			expected := context.DeadlineExceeded
+			if mode == "cancelled_request" {
+				expected = context.Canceled
+			}
+			if err := <-proxy.finished; err != expected {
+				t.Fatalf("URLTest ended with %v, want %v", err, expected)
+			}
+			if child.Err() != expected {
+				t.Fatalf("test context error = %v", child.Err())
+			}
+			if recorder.Code != http.StatusGatewayTimeout {
+				t.Fatalf("status = %d, want %d", recorder.Code, http.StatusGatewayTimeout)
+			}
+		})
+	}
+}
