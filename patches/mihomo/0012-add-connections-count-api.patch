+package route
+
+import (
+	"bytes"
+	"encoding/json"
+	"strconv"
+	"time"
+
+	"github.com/metacubex/mihomo/tunnel/statistic"
+
+	"github.com/metacubex/chi/render"
+	"github.com/metacubex/http"
+)
+
+type connectionCount struct {
+	Count int `json:"count"`
+}
+
+func getConnectionCount(w http.ResponseWriter, r *http.Request) {
+	count := func() connectionCount {
+		return connectionCount{Count: statistic.DefaultManager.ConnectionCount()}
+	}
+	if r.Header.Get("Upgrade") != "websocket" {
+		render.JSON(w, r, count())
+		return
+	}
+
+	interval := 1000
+	if value := r.URL.Query().Get("interval"); value != "" {
+		var err error
+		interval, err = strconv.Atoi(value)
+		if err != nil || interval < 100 || interval > 60000 {
+			render.Status(r, http.StatusBadRequest)
+			render.JSON(w, r, ErrBadRequest)
+			return
+		}
+	}
+
+	conn, _, err := wsUpgrade(r, w)
+	if conn != nil {
+		defer conn.Close()
+	}
+	if err != nil {
+		return
+	}
+	var buf bytes.Buffer
+	encoder := json.NewEncoder(&buf)
+	send := func() error {
+		buf.Reset()
+		if err := encoder.Encode(count()); err != nil {
+			return err
+		}
+		if err := conn.SetWriteDeadline(time.Now().Add(5 * time.Second)); err != nil {
+			return err
+		}
+		return wsWriteServerText(conn, buf.Bytes())
+	}
+	if send() != nil {
+		return
+	}
+	tick := time.NewTicker(time.Duration(interval) * time.Millisecond)
+	defer tick.Stop()
+	for {
+		select {
+		case <-r.Context().Done():
+			return
+		case <-tick.C:
+			if send() != nil {
+				return
+			}
+		}
+	}
+}
