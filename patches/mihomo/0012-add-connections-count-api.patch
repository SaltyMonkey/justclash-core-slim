@@ -0,0 +1,77 @@
+package statistic
+
+import (
+	"strconv"
+	"sync"
+	"testing"
+)
+
+type countOnlyTracker struct {
+	Tracker
+	id string
+}
+
+func (c countOnlyTracker) ID() string { return c.id }
+
+func TestConnectionCountLifecycle(t *testing.T) {
+	var manager Manager
+	a, b := countOnlyTracker{id: "a"}, countOnlyTracker{id: "b"}
+	check := func(want int) {
+		t.Helper()
+		if got := manager.ConnectionCount(); got != want {
+			t.Fatalf("count = %d, want %d", got, want)
+		}
+	}
+	check(0)
+	manager.Join(a)
+	manager.Join(a)
+	manager.Join(b)
+	check(2)
+	manager.Leave(a)
+	manager.Leave(a)
+	check(1)
+	manager.ResetStatistic()
+	check(1)
+	manager.Leave(b)
+	check(0)
+}
+
+func TestConnectionCountConcurrent(t *testing.T) {
+	var manager Manager
+	var workers sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		workers.Add(1)
+		go func(id int) {
+			defer workers.Done()
+			tracker := countOnlyTracker{id: strconv.Itoa(id)}
+			for j := 0; j < 1000; j++ {
+				manager.Join(tracker)
+				if manager.ConnectionCount() < 0 {
+					t.Error("connection count became negative")
+				}
+				manager.Leave(tracker)
+			}
+		}(i)
+	}
+	workers.Wait()
+	if manager.ConnectionCount() != 0 {
+		t.Fatal("closed connections remain counted")
+	}
+}
+
+func BenchmarkConnectionCount(b *testing.B) {
+	for _, size := range []int{0, 10000} {
+		b.Run(strconv.Itoa(size), func(b *testing.B) {
+			var manager Manager
+			for i := 0; i < size; i++ {
+				manager.Join(countOnlyTracker{id: strconv.Itoa(i)})
+			}
+			manager.ConnectionCount()
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				manager.ConnectionCount()
+			}
+		})
+	}
+}
