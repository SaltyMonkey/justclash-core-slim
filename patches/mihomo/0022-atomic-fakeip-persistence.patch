+func TestPersistentFakeIPProcessChild(t *testing.T) {
+	path := os.Getenv("MIHOMO_FAKEIP_TEST_DB")
+	if path == "" {
+		t.Skip("subprocess helper")
+	}
+	db, err := bbolt.Open(path, 0o600, &bbolt.Options{NoStatistics: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	prefix := netip.PrefixFrom(netip.AddrFrom4([4]byte{198, 18}), 24)
+	if os.Getenv("MIHOMO_FAKEIP_TEST_IPV6") == "true" {
+		prefix = netip.PrefixFrom(netip.AddrFrom16([16]byte{0: 0xfd}), 120)
+	}
+	p := persistentTestPool(t, db, prefix)
+	for i := 0; i < 6; i++ {
+		p.Lookup(fmt.Sprintf("synthetic-kill-%d", i))
+	}
+	// Parent kills the process here: no Close, StoreState or shutdown callbacks.
+	fmt.Fprintln(os.Stdout, "FAKEIP_READY")
+	<-time.After(time.Minute)
+	t.Fatal("parent did not kill the subprocess")
+}
