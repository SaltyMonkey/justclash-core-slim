+// Seed the unchanged on-disk format in one setup transaction. Setup is not timed.
+func benchmarkSavedFakeIPFile(b *testing.B, count int) (string, netip.Prefix, []string, []netip.Addr) {
+	b.Helper()
+	path := filepath.Join(b.TempDir(), "synthetic.db")
+	prefix := netip.PrefixFrom(netip.AddrFrom4([4]byte{198, 18}), 16)
+	db, err := bbolt.Open(path, 0o600, &bbolt.Options{NoStatistics: true})
+	if err != nil {
+		b.Fatal(err)
+	}
+	names := make([]string, count)
+	addresses := make([]netip.Addr, count)
+	address := prefix.Addr().Next().Next().Next().Next()
+	err = db.Update(func(tx *bbolt.Tx) error {
+		bucket, err := tx.CreateBucketIfNotExists([]byte("fakeip"))
+		if err != nil {
+			return err
+		}
+		for i := 0; i < count; i++ {
+			names[i] = "synthetic-" + strconv.Itoa(i)
+			addresses[i] = address
+			if err = bucket.Put(address.AsSlice(), []byte(names[i])); err != nil {
+				return err
+			}
+			if err = bucket.Put([]byte(names[i]), address.AsSlice()); err != nil {
+				return err
+			}
+			address = address.Next()
+		}
+		if count > 0 {
+			return bucket.Put([]byte(offsetKey), addresses[count-1].AsSlice())
+		}
+		return nil
+	})
+	if err != nil {
+		db.Close()
+		b.Fatal(err)
+	}
+	if err = db.Close(); err != nil {
+		b.Fatal(err)
+	}
+	return path, prefix, names, addresses
+}
