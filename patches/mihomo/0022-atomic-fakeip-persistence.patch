+func TestPersistentFakeIP500LegacyRecovery(t *testing.T) {
+	for _, stale := range []bool{false, true} {
+		t.Run(fmt.Sprint(stale), func(t *testing.T) {
+			db, err := bbolt.Open(filepath.Join(t.TempDir(), "synthetic.db"), 0o600, &bbolt.Options{NoStatistics: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer db.Close()
+			prefix := netip.PrefixFrom(netip.AddrFrom4([4]byte{198, 18}), 16)
+			address := prefix.Addr().Next().Next().Next().Next()
+			names := make([]string, 500)
+			addresses := make([]netip.Addr, 500)
+			err = db.Update(func(tx *bbolt.Tx) error {
+				bucket, err := tx.CreateBucketIfNotExists([]byte("fakeip"))
+				if err != nil {
+					return err
+				}
+				for i := 0; i < 500; i++ {
+					names[i] = fmt.Sprintf("synthetic-legacy-%d", i)
+					addresses[i] = address
+					if err = bucket.Put(address.AsSlice(), []byte(names[i])); err != nil {
+						return err
+					}
+					if err = bucket.Put([]byte(names[i]), address.AsSlice()); err != nil {
+						return err
+					}
+					address = address.Next()
+				}
+				if stale {
+					return bucket.Put([]byte(offsetKey), addresses[0].AsSlice())
+				}
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			p := persistentTestPool(t, db, prefix)
+			if got := p.Lookup("synthetic-fresh"); got != address {
+				t.Fatal("legacy cursor caused premature address reuse")
+			}
+			for i, name := range names {
+				if got, ok := p.store.GetByHost(name); !ok || got != addresses[i] {
+					t.Fatal("one of 500 saved forward mappings was lost")
+				}
+				if got, ok := p.LookBack(addresses[i]); !ok || got != name {
+					t.Fatal("one of 500 saved reverse mappings was lost")
+				}
+			}
+		})
+	}
