+// These benchmarks also compile without the atomic-write patch, for an actual before/after comparison.
+func benchmarkPersistentPool(b *testing.B, bits int) (*Pool, *bbolt.DB) {
+	b.Helper()
+	db, err := bbolt.Open(filepath.Join(b.TempDir(), "synthetic.db"), 0o600, &bbolt.Options{NoStatistics: true})
+	if err != nil {
+		b.Fatal(err)
+	}
+	b.Cleanup(func() { db.Close() })
+	prefix := netip.PrefixFrom(netip.AddrFrom4([4]byte{198, 18}), bits)
+	p, err := New(Options{IPNet: prefix, Size: 32})
+	if err != nil {
+		b.Fatal(err)
+	}
+	p.store = newCachefileStore(&cachefile.CacheFile{DB: db}, prefix)
+	// Match production: synchronous durability and the default Batch delay/size.
+	return p, db
+}
