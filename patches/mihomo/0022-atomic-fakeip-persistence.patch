+func BenchmarkPersistentFakeIPOpenAndRestore(b *testing.B) {
+	for _, count := range []int{0, 10000} {
+		b.Run(strconv.Itoa(count), func(b *testing.B) {
+			path, prefix, _, _ := benchmarkSavedFakeIPFile(b, count)
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				db, err := bbolt.Open(path, 0o600, &bbolt.Options{NoStatistics: true})
+				if err != nil {
+					b.Fatal(err)
+				}
+				p := benchmarkRestorePool(b, db, prefix)
+				if count > 0 && p.offset == p.first.Prev() {
+					db.Close()
+					b.Fatal("cursor not restored")
+				}
+				if err = db.Close(); err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
