+++ b/component/fakeip/persistence_test.go
@@ -0,0 +1,358 @@
+package fakeip
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"net/netip"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/metacubex/bbolt"
+	"github.com/metacubex/mihomo/component/profile/cachefile"
+)
+
+func persistentTestPool(tb testing.TB, db *bbolt.DB, prefix netip.Prefix) *Pool {
+	tb.Helper()
+	// Inject a synthetic database; never touch the process-wide cache singleton.
+	p, err := New(Options{IPNet: prefix, Size: 32})
+	if err != nil {
+		tb.Fatal(err)
+	}
+	p.store = newCachefileStore(&cachefile.CacheFile{DB: db}, prefix)
+	p.restoreState()
+	return p
+}
+
+func TestPersistentFakeIPCleanRestart(t *testing.T) {
+	for _, ipv6 := range []bool{false, true} {
+		for _, cycle := range []bool{false, true} {
+			t.Run(fmt.Sprintf("ipv6=%t/cycle=%t", ipv6, cycle), func(t *testing.T) {
+				prefix := netip.PrefixFrom(netip.AddrFrom4([4]byte{198, 18}), 24)
+				if ipv6 {
+					prefix = netip.PrefixFrom(netip.AddrFrom16([16]byte{0: 0xfd}), 120)
+				}
+				if cycle {
+					prefix = netip.PrefixFrom(prefix.Addr(), prefix.Addr().BitLen()-3)
+				}
+				path := filepath.Join(t.TempDir(), "synthetic.db")
+				db, err := bbolt.Open(path, 0o600, &bbolt.Options{NoStatistics: true})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer func() {
+					if db != nil {
+						db.Close()
+					}
+				}()
+				db.MaxBatchSize = 1
+				p := persistentTestPool(t, db, prefix)
+				last := p.Lookup("synthetic-0")
+				for i := 1; i < 12; i++ {
+					last = p.Lookup(fmt.Sprintf("synthetic-%d", i))
+				}
+				position, wrapped := p.offset, p.cycle
+				// Shutdown callers remain compatible; allocation has already saved the cursor.
+				p.StoreState()
+				if err = db.Close(); err != nil {
+					t.Fatal(err)
+				}
+				db = nil
+				reopened, err := bbolt.Open(path, 0o600, &bbolt.Options{NoStatistics: true})
+				if err != nil {
+					t.Fatal(err)
+				}
+				db = reopened
+				db.MaxBatchSize = 1
+				p = persistentTestPool(t, db, prefix)
+				if p.offset != position || p.cycle != wrapped {
+					t.Fatal("allocation cursor changed after restart")
+				}
+				if got, ok := p.LookBack(last); !ok || got != "synthetic-11" {
+					t.Fatal("saved reverse mapping changed after restart")
+				}
+				if got := p.Lookup("synthetic-11"); got != last {
+					t.Fatal("saved forward mapping changed after restart")
+				}
+				next := p.Lookup("synthetic-next")
+				expected := position.Next()
+				if !expected.Less(p.last) {
+					expected = p.first
+				}
+				if next != expected {
+					t.Fatal("restart changed the next allocated address")
+				}
+			})
+		}
+	}
+}
+
+func TestPersistentFakeIPReadsLegacyRecords(t *testing.T) {
+	db, err := bbolt.Open(filepath.Join(t.TempDir(), "synthetic.db"), 0o600, &bbolt.Options{NoStatistics: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.MaxBatchSize = 1
+	prefix := netip.PrefixFrom(netip.AddrFrom4([4]byte{198, 18}), 24)
+	address := prefix.Addr().Next().Next().Next().Next()
+	store := (&cachefile.CacheFile{DB: db}).FakeIpStore()
+	store.PutByIP(address, "synthetic-legacy")
+	store.PutByHost("synthetic-legacy", address)
+	store.PutByHost(offsetKey, address)
+	p := persistentTestPool(t, db, prefix)
+	if got := p.Lookup("synthetic-legacy"); got != address {
+		t.Fatal("legacy forward mapping was not restored")
+	}
+	if got, ok := p.LookBack(address); !ok || got != "synthetic-legacy" {
+		t.Fatal("legacy reverse mapping was not restored")
+	}
+}
+
+func TestPersistentFakeIPLegacyCheckpointRecovery(t *testing.T) {
+	for _, ipv6 := range []bool{false, true} {
+		for _, stale := range []bool{false, true} {
+			t.Run(fmt.Sprintf("ipv6=%t/stale=%t", ipv6, stale), func(t *testing.T) {
+				db, err := bbolt.Open(filepath.Join(t.TempDir(), "synthetic.db"), 0o600, &bbolt.Options{NoStatistics: true})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer db.Close()
+				db.MaxBatchSize = 1
+				prefix := netip.PrefixFrom(netip.AddrFrom4([4]byte{198, 18}), 24)
+				cf := &cachefile.CacheFile{DB: db}
+				store := cf.FakeIpStore()
+				if ipv6 {
+					prefix = netip.PrefixFrom(netip.AddrFrom16([16]byte{0: 0xfd}), 120)
+					store = cf.FakeIpStore6()
+				}
+				address := prefix.Addr().Next().Next().Next().Next()
+				saved := make(map[string]netip.Addr)
+				for i := 0; i < 8; i++ {
+					name := fmt.Sprintf("synthetic-legacy-%d", i)
+					saved[name] = address
+					store.PutByIP(address, name)
+					store.PutByHost(name, address)
+					if i == 0 && stale {
+						store.PutByHost(offsetKey, address)
+					}
+					address = address.Next()
+				}
+				p := persistentTestPool(t, db, prefix)
+				for name, address := range saved {
+					if got := p.Lookup(name); got != address {
+						t.Fatal("legacy forward mapping changed during initialization")
+					}
+					if got, ok := p.LookBack(address); !ok || got != name {
+						t.Fatal("legacy reverse mapping changed during initialization")
+					}
+				}
+				allocated := p.Lookup("synthetic-fresh")
+				for name, address := range saved {
+					if allocated == address {
+						t.Fatal("stale checkpoint caused premature address reuse")
+					}
+					if got, ok := store.GetByHost(name); !ok || got != address {
+						t.Fatal("legacy mapping lost during cursor recovery")
+					}
+				}
+				offset, ok := store.GetByHost(offsetKey)
+				_, cycle := store.GetByHost(cycleKey)
+				if !ok || offset != allocated || cycle {
+					t.Fatal("recovered cursor was not committed")
+				}
+			})
+		}
+	}
+}
