+func TestPersistentFakeIPReloadKeepsLiveAllocations(t *testing.T) {
+	db, err := bbolt.Open(filepath.Join(t.TempDir(), "synthetic.db"), 0o600, &bbolt.Options{NoStatistics: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.MaxBatchSize = 1
+	prefix := netip.PrefixFrom(netip.AddrFrom4([4]byte{198, 18}), 16)
+	old := persistentTestPool(t, db, prefix)
+	saved := old.Lookup("synthetic-original")
+	reloaded := persistentTestPool(t, db, prefix)
+	reloaded.CloneFrom(old)
+	if got := reloaded.Lookup("synthetic-original"); got != saved {
+		t.Fatal("reload changed an existing mapping")
+	}
+	type allocation struct {
+		name    string
+		address netip.Addr
+	}
+	results := make(chan allocation, 128)
+	var writers sync.WaitGroup
+	for worker, pool := range []*Pool{old, reloaded} {
+		writers.Add(1)
+		go func(worker int, pool *Pool) {
+			defer writers.Done()
+			for i := 0; i < 64; i++ {
+				name := fmt.Sprintf("synthetic-worker-%d-%d", worker, i)
+				results <- allocation{name, pool.Lookup(name)}
+			}
+		}(worker, pool)
+	}
+	writers.Wait()
+	close(results)
+	seen := map[netip.Addr]bool{saved: true}
+	for result := range results {
+		if seen[result.address] {
+			t.Fatal("old and new resolvers reused an allocated address")
+		}
+		seen[result.address] = true
+		if got, ok := reloaded.LookBack(result.address); !ok || got != result.name {
+			t.Fatal("live allocation lost after reload")
+		}
+	}
+	// A late shutdown of the old resolver must not overwrite the new cursor.
+	old.StoreState()
+	address := reloaded.Lookup("synthetic-after-old-shutdown")
+	if seen[address] {
+		t.Fatal("old shutdown rewound the allocation cursor")
+	}
+}
