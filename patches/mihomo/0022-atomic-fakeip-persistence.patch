+			path, prefix, names, addresses := benchmarkSavedFakeIPFile(b, 10000)
+			db, err := bbolt.Open(path, 0o600, &bbolt.Options{NoStatistics: true})
+			if err != nil {
+				b.Fatal(err)
+			}
+			defer db.Close()
+			expected := addresses[len(addresses)-1].Next()
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				b.StopTimer()
+				err = db.Update(func(tx *bbolt.Tx) error {
+					bucket := tx.Bucket([]byte("fakeip"))
+					if err := bucket.Delete([]byte("synthetic-recovered")); err != nil {
+						return err
+					}
+					if err := bucket.Delete(expected.AsSlice()); err != nil {
+						return err
+					}
+					if err := bucket.Delete([]byte(cycleKey)); err != nil {
+						return err
+					}
+					if stale {
+						return bucket.Put([]byte(offsetKey), addresses[0].AsSlice())
+					}
+					return bucket.Delete([]byte(offsetKey))
+				})
+				if err != nil {
+					b.Fatal(err)
+				}
+				p := benchmarkRestorePool(b, db, prefix)
+				if _, ok := p.store.GetByHost(names[0]); !ok {
+					b.Skip("baseline erases a legacy cache without a cursor")
+				}
+				b.StartTimer()
+				if got := p.Lookup("synthetic-recovered"); got != expected {
+					b.Fatal("legacy cursor recovery overwrote an existing mapping")
+				}
+			}
+			b.StopTimer()
+		})
+	}
