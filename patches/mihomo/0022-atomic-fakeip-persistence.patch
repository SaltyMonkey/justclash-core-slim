+func TestPersistentFakeIPAfterProcessKill(t *testing.T) {
+	for _, ipv6 := range []bool{false, true} {
+		t.Run(fmt.Sprint(ipv6), func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "synthetic.db")
+			executable, err := os.Executable()
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+			defer cancel()
+			cmd := exec.CommandContext(ctx, executable, "-test.run=^TestPersistentFakeIPProcessChild$")
+			cmd.Env = append(os.Environ(), "MIHOMO_FAKEIP_TEST_DB="+path, "MIHOMO_FAKEIP_TEST_IPV6="+strconv.FormatBool(ipv6))
+			output, err := cmd.StdoutPipe()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = cmd.Start(); err != nil {
+				t.Fatal(err)
+			}
+			defer func() { cmd.Process.Kill(); cmd.Wait() }()
+			ready, err := bufio.NewReader(output).ReadString('\n')
+			if err != nil || strings.TrimSpace(ready) != "FAKEIP_READY" {
+				t.Fatal("child did not finish its committed allocations")
+			}
+			if err = cmd.Process.Kill(); err != nil {
+				t.Fatal(err)
+			}
+			if err = cmd.Wait(); err == nil {
+				t.Fatal("child was not killed")
+			}
+			db, err := bbolt.Open(path, 0o600, &bbolt.Options{NoStatistics: true, Timeout: time.Second})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer db.Close()
+			prefix := netip.PrefixFrom(netip.AddrFrom4([4]byte{198, 18}), 24)
+			if ipv6 {
+				prefix = netip.PrefixFrom(netip.AddrFrom16([16]byte{0: 0xfd}), 120)
+			}
+			p := persistentTestPool(t, db, prefix)
+			seen := make(map[netip.Addr]bool)
+			for i := 0; i < 6; i++ {
+				name := fmt.Sprintf("synthetic-kill-%d", i)
+				address, ok := p.store.GetByHost(name)
+				if !ok {
+					t.Fatal("committed mapping missing after process kill")
+				}
+				if got, ok := p.LookBack(address); !ok || got != name {
+					t.Fatal("reverse mapping missing after process kill")
+				}
+				seen[address] = true
+			}
+			if address := p.Lookup("synthetic-after-kill"); seen[address] {
+				t.Fatal("process kill lost the allocation position")
+			}
+		})
+	}
+}
