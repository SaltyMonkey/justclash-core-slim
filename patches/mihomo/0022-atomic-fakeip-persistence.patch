diff --git a/component/profile/cachefile/fakeip.go b/component/profile/cachefile/fakeip.go
--- a/component/profile/cachefile/fakeip.go
+++ b/component/profile/cachefile/fakeip.go
@@ -1,6 +1,8 @@
 package cachefile
 
 import (
+	"bytes"
+	"errors"
 	"net/netip"
 
 	"github.com/metacubex/mihomo/log"
@@ -33,6 +35,112 @@
 		}
 		return nil
 	})
+	return
+}
+
+const (
+	// Keep the existing on-disk keys so older cores can still read the cache.
+	FakeIPOffsetKey = "key-offset-fake-ip"
+	FakeIPCycleKey  = "key-cycle-fake-ip"
+)
+
+func readFakeIPState(bucket *bbolt.Bucket) (offset netip.Addr, cycle bool) {
+	if bucket != nil {
+		offset, _ = netip.AddrFromSlice(bucket.Get([]byte(FakeIPOffsetKey)))
+		cycle = offset.IsValid() && bucket.Get([]byte(FakeIPCycleKey)) != nil
+	}
+	return
+}
+
+// State reads the cursor and wrap marker from the same snapshot.
+func (c *FakeIpStore) State() (offset netip.Addr, cycle bool) {
+	if c.DB == nil {
+		return
+	}
+	c.DB.View(func(tx *bbolt.Tx) error {
+		offset, cycle = readFakeIPState(tx.Bucket(c.bucketName))
+		return nil
+	})
+	return
+}
+
+// Allocate commits the mapping and allocation state together. A mapping does not
+// need a trilogy of commits, followed by a cursor saved whenever shutdown remembers.
+func (c *FakeIpStore) Allocate(host string, first, last netip.Addr) (address, offset netip.Addr, cycle bool, err error) {
+	if c.DB == nil {
+		return address, offset, cycle, bbolt.ErrDatabaseNotOpen
+	}
+	if !first.IsValid() || !first.Prev().IsValid() || !last.IsValid() || first.Is4() != last.Is4() || !first.Less(last) {
+		return address, offset, cycle, errors.New("invalid fake-IP allocation range")
+	}
+	// Each pool serializes its lookups. Batch would wait to collect writes that the
+	// same pool cannot submit; Update keeps the normal synchronous durability.
+	err = c.DB.Update(func(tx *bbolt.Tx) error {
+		bucket, err := tx.CreateBucketIfNotExists(c.bucketName)
+		if err != nil {
+			return err
+		}
+		offset, cycle = readFakeIPState(bucket)
+		if !offset.IsValid() || offset.Is4() != first.Is4() || offset.Less(first.Prev()) || !offset.Less(last) {
+			offset, cycle = first.Prev(), false
+		}
+		// A previous resolver may still be finishing a lookup after a reload. Recheck
+		// the name and use the committed cursor instead of either pool's local copy.
+		if existing, ok := netip.AddrFromSlice(bucket.Get([]byte(host))); ok && !existing.Less(first) && existing.Less(last) {
+			address = existing
+			return nil
+		}
+		offset = offset.Next()
+		if !offset.Less(last) {
+			offset, cycle = first, true
+		}
+		if !cycle {
+			// Legacy records can extend beyond the checkpoint. Walk them with one
+			// cursor, rather than allocating a fresh cursor for every occupied address.
+			cursor := bucket.Cursor()
+			key, _ := cursor.Seek(offset.AsSlice())
+			for !cycle {
+				raw := offset.AsSlice()
+				// Host keys and address keys share this bucket and may be interleaved.
+				for key != nil && bytes.Compare(key, raw) < 0 {
+					key, _ = cursor.Next()
+				}
+				if !bytes.Equal(key, raw) {
+					break
+				}
+				offset = offset.Next()
+				if !offset.Less(last) {
+					offset, cycle = first, true
+				}
+			}
+		}
+		rawAddress := offset.AsSlice()
+		if previous := bucket.Get(rawAddress); len(previous) > 0 {
+			if err = bucket.Delete(previous); err != nil {
+				return err
+			}
+		}
+		if err = bucket.Put(rawAddress, []byte(host)); err != nil {
+			return err
+		}
+		if err = bucket.Put([]byte(host), rawAddress); err != nil {
+			return err
+		}
+		if err = bucket.Put([]byte(FakeIPOffsetKey), rawAddress); err != nil {
+			return err
+		}
+		if cycle {
+			err = bucket.Put([]byte(FakeIPCycleKey), rawAddress)
+		} else {
+			err = bucket.Delete([]byte(FakeIPCycleKey))
+		}
+		address = offset
+		return err
+	})
+	if err != nil {
+		log.Warnln("[CacheFile] write cache to %s failed: %s", c.DB.Path(), err.Error())
+		return netip.Addr{}, netip.Addr{}, false, err
+	}
 	return
 }
 
diff --git a/component/profile/cachefile/fakeip_atomic_test.go b/component/profile/cachefile/fakeip_atomic_test.go
new file mode 100644
--- /dev/null
+++ b/component/profile/cachefile/fakeip_atomic_test.go
@@ -0,0 +1,235 @@
+package cachefile
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"net/netip"
+	"path/filepath"
+	"testing"
+
+	"github.com/metacubex/bbolt"
+)
+
+func openAtomicFakeIPDB(t *testing.T) *bbolt.DB {
+	t.Helper()
+	db, err := bbolt.Open(filepath.Join(t.TempDir(), "synthetic.db"), 0o600, &bbolt.Options{NoStatistics: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Legacy fixture setters need transactions, not a tea break per batch.
+	db.MaxBatchSize = 1
+	t.Cleanup(func() {
+		if err := db.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return db
+}
+
+func allocateSingleFakeIP(t *testing.T, store *FakeIpStore, host string, address netip.Addr) {
+	t.Helper()
+	got, offset, _, err := store.Allocate(host, address, address.Next())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != address || offset != address {
+		t.Fatal("unexpected allocation")
+	}
+}
+
+func TestFakeIPAllocateReplacesOwner(t *testing.T) {
+	for _, ipv6 := range []bool{false, true} {
+		t.Run(fmt.Sprint(ipv6), func(t *testing.T) {
+			db := openAtomicFakeIPDB(t)
+			cf := &CacheFile{DB: db}
+			store, other := cf.FakeIpStore(), cf.FakeIpStore6()
+			address := netip.AddrFrom4([4]byte{198, 18, 0, 4})
+			if ipv6 {
+				store, other = other, store
+				address = netip.AddrFrom16([16]byte{0: 0xfd, 15: 4})
+			}
+			// Seed the existing format using the old individual setters.
+			store.PutByIP(address, "synthetic-old")
+			store.PutByHost("synthetic-old", address)
+			other.PutByIP(address, "synthetic-other-bucket")
+			other.PutByHost("synthetic-other-bucket", address)
+			allocateSingleFakeIP(t, store, "synthetic-new", address)
+			if _, ok := store.GetByHost("synthetic-old"); ok {
+				t.Fatal("previous owner survived replacement")
+			}
+			if got, ok := store.GetByHost("synthetic-new"); !ok || got != address {
+				t.Fatal("forward mapping missing")
+			}
+			if got, ok := store.GetByIP(address); !ok || got != "synthetic-new" {
+				t.Fatal("reverse mapping missing")
+			}
+			if got, cycle := store.State(); got != address || !cycle {
+				t.Fatal("allocation state was not committed with the replacement")
+			}
+			if got, ok := other.GetByIP(address); !ok || got != "synthetic-other-bucket" {
+				t.Fatal("other bucket changed")
+			}
+		})
+	}
+}
+
+func TestFakeIPAllocateRollsBackMappingAndState(t *testing.T) {
+	db := openAtomicFakeIPDB(t)
+	store := (&CacheFile{DB: db}).FakeIpStore()
+	address := netip.AddrFrom4([4]byte{198, 18, 0, 4})
+	allocateSingleFakeIP(t, store, "synthetic-original", address)
+	// The final mapping Put rejects an empty key, after deleting the previous owner
+	// and changing the reverse entry. The cursor and wrap marker must not advance.
+	if _, _, _, err := store.Allocate("", address, address.Next()); !errors.Is(err, bbolt.ErrKeyRequired) {
+		t.Fatal("invalid key did not abort the transaction")
+	}
+	if got, ok := store.GetByHost("synthetic-original"); !ok || got != address {
+		t.Fatal("failed transaction lost forward mapping")
+	}
+	if got, ok := store.GetByIP(address); !ok || got != "synthetic-original" {
+		t.Fatal("failed transaction changed reverse mapping")
+	}
+	if got, cycle := store.State(); got != address || cycle {
+		t.Fatal("failed transaction changed allocation state")
+	}
+}
+
+func TestFakeIPAllocateReadersSeeCompleteMappingAndState(t *testing.T) {
+	db := openAtomicFakeIPDB(t)
+	store := (&CacheFile{DB: db}).FakeIpStore()
+	address := netip.AddrFrom4([4]byte{198, 18, 0, 4})
+	allocateSingleFakeIP(t, store, "synthetic-0", address)
+	done := make(chan struct{})
+	failures := make(chan error, 1)
+	go func() {
+		defer close(done)
+		for i := 0; i < 64; i++ {
+			if _, _, _, err := store.Allocate(fmt.Sprintf("synthetic-%d", i+1), address, address.Next()); err != nil {
+				failures <- err
+				return
+			}
+		}
+	}()
+	defer func() { <-done }()
+	for {
+		err := db.View(func(tx *bbolt.Tx) error {
+			bucket := tx.Bucket(store.bucketName)
+			owner := bucket.Get(address.AsSlice())
+			if len(owner) == 0 {
+				return fmt.Errorf("reverse mapping missing")
+			}
+			if got, ok := netip.AddrFromSlice(bucket.Get(owner)); !ok || got != address {
+				return fmt.Errorf("reader observed an incomplete pair")
+			}
+			if offset, _ := readFakeIPState(bucket); offset != address {
+				return fmt.Errorf("reader observed a stale cursor")
+			}
+			owners := 0
+			if err := bucket.ForEach(func(k, _ []byte) error {
+				if bytes.HasPrefix(k, []byte("synthetic-")) {
+					owners++
+				}
+				return nil
+			}); err != nil {
+				return err
+			}
+			if owners != 1 {
+				return fmt.Errorf("reader observed a stale owner")
+			}
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case <-done:
+			select {
+			case err := <-failures:
+				t.Fatal(err)
+			default:
+			}
+			return
+		default:
+		}
+	}
+}
+
+func TestFakeIPAllocateReplacesEmptyLegacyOwner(t *testing.T) {
+	db := openAtomicFakeIPDB(t)
+	store := (&CacheFile{DB: db}).FakeIpStore()
+	address := netip.AddrFrom4([4]byte{198, 18, 0, 4})
+	store.PutByIP(address, "")
+	allocateSingleFakeIP(t, store, "synthetic-repaired", address)
+	if got, ok := store.GetByHost("synthetic-repaired"); !ok || got != address {
+		t.Fatal("empty legacy owner blocked replacement")
+	}
+	if got, ok := store.GetByIP(address); !ok || got != "synthetic-repaired" {
+		t.Fatal("empty legacy reverse entry survived")
+	}
+}
+
+func TestFakeIPAllocateRechecksExistingName(t *testing.T) {
+	db := openAtomicFakeIPDB(t)
+	store := (&CacheFile{DB: db}).FakeIpStore()
+	first := netip.AddrFrom4([4]byte{198, 18, 0, 4})
+	last := first.Next().Next().Next()
+	saved, _, _, err := store.Allocate("synthetic-known", first, last)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, cursor, cycle, err := store.Allocate("synthetic-other", first, last)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, offset, wrapped, err := store.Allocate("synthetic-known", first, last)
+	if err != nil || got != saved || offset != cursor || wrapped != cycle {
+		t.Fatal("repeated allocation changed the mapping or rewound the cursor")
+	}
+}
+
+func TestFakeIPAllocateWithoutDatabase(t *testing.T) {
+	store := (&CacheFile{}).FakeIpStore()
+	first := netip.AddrFrom4([4]byte{198, 18, 0, 4})
+	if _, _, _, err := store.Allocate("synthetic", first, first.Next()); !errors.Is(err, bbolt.ErrDatabaseNotOpen) {
+		t.Fatal("unavailable database was not reported")
+	}
+}
+
+func TestFakeIPAllocateSkipsInterleavedLegacyKeys(t *testing.T) {
+	db := openAtomicFakeIPDB(t)
+	store := (&CacheFile{DB: db}).FakeIpStore()
+	// This synthetic range deliberately sorts among the ordinary text keys.
+	first := netip.AddrFrom4([4]byte{'a', 'a', 'a', 'a'})
+	last := first.Next().Next().Next()
+	for i, address := range []netip.Addr{first, first.Next()} {
+		name := fmt.Sprintf("synthetic-existing-%d", i)
+		store.PutByIP(address, name)
+		store.PutByHost(name, address)
+	}
+	store.PutByHost("aaaa-synthetic-interleaved", last.Next())
+	address, _, _, err := store.Allocate("synthetic-new", first, last)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if address != first.Next().Next() {
+		t.Fatal("interleaved host key hid an occupied address")
+	}
+	if got, ok := store.GetByIP(first.Next()); !ok || got != "synthetic-existing-1" {
+		t.Fatal("occupied address was overwritten during legacy recovery")
+	}
+}
+
+func TestFakeIPAllocateRejectsInvalidRange(t *testing.T) {
+	db := openAtomicFakeIPDB(t)
+	store := (&CacheFile{DB: db}).FakeIpStore()
+	first := netip.AddrFrom4([4]byte{198, 18, 0, 4})
+	for _, bounds := range [][2]netip.Addr{
+		{}, {first, first}, {first.Next(), first}, {first, netip.AddrFrom16([16]byte{0: 0xfd})},
+		{netip.AddrFrom4([4]byte{}), netip.AddrFrom4([4]byte{0, 0, 0, 1})},
+	} {
+		if _, _, _, err := store.Allocate("synthetic", bounds[0], bounds[1]); err == nil {
+			t.Fatal("invalid allocation range was accepted")
+		}
+	}
+}
