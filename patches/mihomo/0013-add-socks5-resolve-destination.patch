+func TestSocks5ResolveDestinationFailure(t *testing.T) {
+	for _, mode := range []string{"dns-error", "canceled", "empty-answer"} {
+		t.Run(mode, func(t *testing.T) {
+			sentinel := errors.New("test resolution failure")
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if mode == "canceled" {
+				cancel()
+				sentinel = context.Canceled
+			} else if mode == "empty-answer" {
+				sentinel = resolver.ErrIPNotFound
+			}
+			setupSocksLocalDNS(t, func(ctx context.Context, _, _ string) ([]netip.Addr, error) {
+				if mode == "canceled" {
+					return nil, ctx.Err()
+				} else if mode == "empty-answer" {
+					return nil, nil
+				}
+				return nil, sentinel
+			})
+			proxy, _ := outbound.NewSocks5(outbound.Socks5Option{ResolveDestination: true})
+			metadata := &C.Metadata{Host: "target.invalid", DstPort: 443}
+			before := *metadata
+			// A DNS failure must return before touching the connection or sending a domain remotely.
+			conn, err := proxy.StreamConnContext(ctx, nil, metadata)
+			if conn != nil || !errors.Is(err, sentinel) || !reflect.DeepEqual(*metadata, before) {
+				t.Fatal("DNS error or cancellation was lost")
+			}
+			client, peer := net.Pipe()
+			defer client.Close()
+			defer peer.Close()
+			proxy, _ = outbound.NewSocks5(outbound.Socks5Option{
+				BasicOption: outbound.BasicOption{DialerForAPI: socksLocalDialer{conn: client}}, ResolveDestination: true,
+			})
+			if conn, err := proxy.DialContext(ctx, metadata); conn != nil || !errors.Is(err, sentinel) {
+				t.Fatal("DialContext lost the destination resolution error")
+			}
+			peer.SetReadDeadline(time.Now().Add(3 * time.Second))
+			var data [1]byte
+			if _, err := peer.Read(data[:]); err != io.EOF {
+				t.Fatal("failed SOCKS connection was not closed before sending handshake bytes")
+			}
+		})
+	}
+}
