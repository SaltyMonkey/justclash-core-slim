+func TestSocks5ResolveDestinationDNSSeparationAndPayload(t *testing.T) {
+	proxyIP := netip.AddrFrom4([4]byte{192, 0, 2, 10})
+	targetIP := netip.AddrFrom4([4]byte{192, 0, 2, 20})
+	for _, enabled := range []bool{false, true} {
+		name := "remote"
+		if enabled {
+			name = "core"
+		}
+		t.Run(name, func(t *testing.T) {
+			targetCalls, proxyCalls := 0, 0
+			setupSocksLocalDNS(t, func(ctx context.Context, host, family string) ([]netip.Addr, error) {
+				targetCalls++
+				if host != "target.invalid" {
+					t.Error("main resolver received the proxy server hostname")
+				}
+				return []netip.Addr{targetIP}, nil
+			})
+			previousProxy, previousDirect := resolver.ProxyServerHostResolver, resolver.DirectHostResolver
+			resolver.ProxyServerHostResolver = socksLocalResolver{lookup: func(ctx context.Context, host, family string) ([]netip.Addr, error) {
+				proxyCalls++
+				if host != "proxy.invalid" {
+					t.Error("proxy resolver received the destination hostname")
+				}
+				return []netip.Addr{proxyIP}, nil
+			}}
+			resolver.DirectHostResolver = socksLocalResolver{lookup: func(context.Context, string, string) ([]netip.Addr, error) {
+				t.Error("SOCKS unexpectedly used the DIRECT resolver")
+				return nil, errors.New("unexpected DIRECT lookup")
+			}}
+			t.Cleanup(func() {
+				resolver.ProxyServerHostResolver, resolver.DirectHostResolver = previousProxy, previousDirect
+			})
+			payload := []byte("GET / HTTP/1.1\r\nHost: target.invalid\r\n\r\n\x00\xff")
+			client, received := socksLocalPeer(t, payload)
+			coreDialer := dialer.NewDialer(dialer.WithNetDialer(dialer.NetDialerFunc(func(ctx context.Context, network, address string) (net.Conn, error) {
+				addr, err := netip.ParseAddrPort(address)
+				if err != nil || addr.Addr() != proxyIP || addr.Port() != 1080 {
+					t.Error("SOCKS server was not resolved using the proxy-server resolver")
+				}
+				return client, nil
+			})))
+			proxy, err := outbound.NewSocks5(outbound.Socks5Option{
+				BasicOption: outbound.BasicOption{DialerForAPI: coreDialer},
+				Name:        "socks-test", Server: "proxy.invalid", Port: 1080, ResolveDestination: enabled,
+			})
+			if err != nil {
+				t.Fatal("SOCKS construction failed")
+			}
+			metadata := &C.Metadata{Host: "target.invalid", DstPort: 443, NetWork: C.TCP}
+			before := *metadata
+			conn, err := proxy.DialContext(context.Background(), metadata)
+			if err != nil {
+				t.Fatal("SOCKS connection failed")
+			}
+			defer conn.Close()
+			if _, err := conn.Write(payload); err != nil {
+				t.Fatal("application payload write failed")
+			}
+			var ack [1]byte
+			if _, err := io.ReadFull(conn, ack[:]); err != nil || ack[0] != 1 {
+				t.Fatal("application payload was not forwarded intact")
+			}
+			want := socks5.ParseAddr("target.invalid:443")
+			wantTargetCalls := 0
+			if enabled {
+				want = socks5.AddrFromStdAddrPort(netip.AddrPortFrom(targetIP, 443))
+				wantTargetCalls = 1
+			}
+			if !bytes.Equal(<-received, want) || targetCalls != wantTargetCalls || proxyCalls != 1 || !reflect.DeepEqual(*metadata, before) {
+				t.Fatal("DNS policy, wire address, or shared metadata changed")
+			}
+		})
+	}
+}
