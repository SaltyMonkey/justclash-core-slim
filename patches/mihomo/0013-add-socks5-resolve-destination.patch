+func (ss *Socks5) IsL3Protocol(metadata *C.Metadata) bool {
+	// DNSDialer must use its bootstrap resolver before entering a local-resolving proxy.
+	return ss.option.ResolveDestination
 }
 
 func (ss *Socks5) clientHandshakeContext(ctx context.Context, c net.Conn, addr socks5.Addr, command socks5.Command, user *socks5.User) (_ socks5.Addr, err error) {
