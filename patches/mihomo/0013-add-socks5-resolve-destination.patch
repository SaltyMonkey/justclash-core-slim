+func TestSocks5ResolveDestinationHostsAndUDP(t *testing.T) {
+	v4 := netip.AddrFrom4([4]byte{192, 0, 2, 1})
+	setupSocksLocalDNS(t, func(context.Context, string, string) ([]netip.Addr, error) {
+		t.Fatal("hosts match must bypass DNS lookup")
+		return nil, nil
+	})
+	value, _ := resolver.NewHostValueByIPs([]netip.Addr{v4})
+	if err := resolver.DefaultHosts.Insert("target.invalid", value); err != nil {
+		t.Fatal("hosts fixture failed")
+	}
+	for _, local := range []bool{false, true} {
+		proxy, _ := outbound.NewSocks5(outbound.Socks5Option{ResolveDestination: local})
+		metadata := &C.Metadata{Host: "target.invalid", DstPort: 443, NetWork: C.UDP}
+		if err := proxy.ResolveUDP(context.Background(), metadata); err != nil || metadata.DstIP != v4 {
+			t.Fatal("existing local UDP resolution changed")
+		}
+	}
+	proxy, _ := outbound.NewSocks5(outbound.Socks5Option{ResolveDestination: true})
+	client, received := socksLocalPeer(t)
+	conn, err := proxy.StreamConnContext(context.Background(), client, &C.Metadata{Host: "target.invalid", DstPort: 443})
+	if err != nil {
+		t.Fatal("hosts-based TCP resolution failed")
+	}
+	conn.Close()
+	if !bytes.Equal(<-received, socks5.AddrFromStdAddrPort(netip.AddrPortFrom(v4, 443))) {
+		t.Fatal("hosts address was not sent to SOCKS")
+	}
+}
