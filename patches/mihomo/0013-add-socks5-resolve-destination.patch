+func TestSocks5ResolveDestinationDialerProxy(t *testing.T) {
+	entryIP := netip.AddrFrom4([4]byte{192, 0, 2, 10})
+	exitIP := netip.AddrFrom4([4]byte{192, 0, 2, 20})
+	targetIP := netip.AddrFrom4([4]byte{192, 0, 2, 30})
+	for _, entryLocal := range []bool{false, true} {
+		for _, exitLocal := range []bool{false, true} {
+			name := "entry-remote"
+			if entryLocal {
+				name = "entry-core"
+			}
+			if exitLocal {
+				name += "/exit-core"
+			} else {
+				name += "/exit-remote"
+			}
+			t.Run(name, func(t *testing.T) {
+				calls := make(map[string]int)
+				setupSocksLocalDNS(t, func(ctx context.Context, host, family string) ([]netip.Addr, error) {
+					calls[host]++
+					switch host {
+					case "exit.invalid":
+						return []netip.Addr{exitIP}, nil
+					case "target.invalid":
+						return []netip.Addr{targetIP}, nil
+					default:
+						return nil, errors.New("unexpected destination lookup")
+					}
+				})
+				previous := resolver.ProxyServerHostResolver
+				resolver.ProxyServerHostResolver = socksLocalResolver{lookup: func(ctx context.Context, host, family string) ([]netip.Addr, error) {
+					calls[host]++
+					if host != "entry.invalid" {
+						return nil, errors.New("unexpected proxy-server lookup")
+					}
+					return []netip.Addr{entryIP}, nil
+				}}
+				t.Cleanup(func() { resolver.ProxyServerHostResolver = previous })
+				client, received := socksLocalChainPeer(t, 2, []byte{7})
+				coreDialer := dialer.NewDialer(dialer.WithNetDialer(dialer.NetDialerFunc(func(ctx context.Context, network, address string) (net.Conn, error) {
+					addr, err := netip.ParseAddrPort(address)
+					if err != nil || addr.Addr() != entryIP || addr.Port() != 1080 {
+						t.Error("wrong dialer-proxy entry address")
+					}
+					return client, nil
+				})))
+				entry, err := outbound.NewSocks5(outbound.Socks5Option{
+					BasicOption: outbound.BasicOption{DialerForAPI: coreDialer},
+					Name:        "entry", Server: "entry.invalid", Port: 1080, ResolveDestination: entryLocal,
+				})
+				if err != nil {
+					t.Fatal("entry SOCKS construction failed")
+				}
+				route := socksLocalTunnel{proxies: map[string]C.Proxy{"entry": adapter.NewProxy(entry)}}
+				exit, err := outbound.NewSocks5(outbound.Socks5Option{
+					BasicOption: outbound.BasicOption{DialerProxy: "entry", TunnelForAPI: route},
+					Name:        "exit", Server: "exit.invalid", Port: 2080, ResolveDestination: exitLocal,
+				})
+				if err != nil {
+					t.Fatal("exit SOCKS construction failed")
+				}
+				metadata := &C.Metadata{Host: "target.invalid", DstPort: 443, NetWork: C.TCP}
+				before := *metadata
+				conn, err := exit.DialContext(context.Background(), metadata)
+				if err != nil {
+					t.Fatal("SOCKS dialer-proxy chain failed")
+				}
+				defer conn.Close()
+				if _, err := conn.Write([]byte{7}); err != nil {
+					t.Fatal("chained payload write failed")
+				}
+				var ack [1]byte
+				if _, err := io.ReadFull(conn, ack[:]); err != nil || ack[0] != 1 {
+					t.Fatal("chained payload was not forwarded")
+				}
+				wantEntry, wantExit := socks5.ParseAddr("exit.invalid:2080"), socks5.ParseAddr("target.invalid:443")
+				wantCalls := map[string]int{"entry.invalid": 1}
+				if entryLocal {
+					wantEntry = socks5.AddrFromStdAddrPort(netip.AddrPortFrom(exitIP, 2080))
+					wantCalls["exit.invalid"] = 1
+				}
+				if exitLocal {
+					wantExit = socks5.AddrFromStdAddrPort(netip.AddrPortFrom(targetIP, 443))
+					wantCalls["target.invalid"] = 1
+				}
+				if !bytes.Equal(<-received, wantEntry) || !bytes.Equal(<-received, wantExit) || !reflect.DeepEqual(calls, wantCalls) || !reflect.DeepEqual(*metadata, before) {
+					t.Fatal("dialer-proxy changed hop resolution, request addresses, or shared metadata")
+				}
+			})
+		}
+	}
+}
