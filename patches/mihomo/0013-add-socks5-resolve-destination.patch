 // StreamConnContext implements C.ProxyAdapter
 func (ss *Socks5) StreamConnContext(ctx context.Context, c net.Conn, metadata *C.Metadata) (net.Conn, error) {
+	if ss.option.ResolveDestination {
+		local := *metadata
+		if err := ss.Base.ResolveUDP(ctx, &local); err != nil {
+			return nil, err
+		}
+		local.Host = "" // SOCKS prefers Host over DstIP; resolving alone is only half the job.
+		metadata = &local
+	}
+
 	if ss.tls {
 		cc := tls.Client(c, ss.tlsConfig)
 		err := cc.HandshakeContext(ctx)
@@ -160,6 +171,11 @@
 	info := ss.Base.ProxyInfo()
 	info.DialerProxy = ss.option.DialerProxy
 	return info
+}
