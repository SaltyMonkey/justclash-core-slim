+func setupSocksLocalDNS(t *testing.T, lookup func(context.Context, string, string) ([]netip.Addr, error)) {
+	t.Helper()
+	previous, previousHosts := resolver.DefaultResolver, resolver.DefaultHosts
+	previousIPv6, previousSystemHosts := resolver.DisableIPv6, resolver.UseSystemHosts
+	resolver.DefaultResolver = socksLocalResolver{lookup: lookup}
+	resolver.DefaultHosts = resolver.NewHosts(trie.New[resolver.HostValue]())
+	resolver.DisableIPv6, resolver.UseSystemHosts = false, false
+	t.Cleanup(func() {
+		resolver.DefaultResolver, resolver.DefaultHosts = previous, previousHosts
+		resolver.DisableIPv6, resolver.UseSystemHosts = previousIPv6, previousSystemHosts
+	})
+}
