+func TestSocks5ResolveDestinationDNSBootstrap(t *testing.T) {
+	setupSocksLocalDNS(t, func(context.Context, string, string) ([]netip.Addr, error) {
+		t.Fatal("DNS transport recursed into the default resolver")
+		return nil, nil
+	})
+	v4 := netip.AddrFrom4([4]byte{192, 0, 2, 1})
+	bootstrapCalls := 0
+	bootstrap := socksLocalResolver{lookup: func(context.Context, string, string) ([]netip.Addr, error) {
+		bootstrapCalls++
+		return []netip.Addr{v4}, nil
+	}}
+	client, received := socksLocalPeer(t)
+	proxy, err := outbound.NewSocks5(outbound.Socks5Option{
+		BasicOption: outbound.BasicOption{DialerForAPI: socksLocalDialer{conn: client}}, ResolveDestination: true,
+	})
+	if err != nil {
+		t.Fatal("SOCKS construction failed")
+	}
+	conn, err := tunnel.NewDNSDialer(bootstrap, proxy, "").DialContext(context.Background(), "tcp", "resolver.invalid:443")
+	if err != nil {
+		t.Fatal("DNS bootstrap through SOCKS failed")
+	}
+	conn.Close()
+	if bootstrapCalls != 1 || !bytes.Equal(<-received, socks5.AddrFromStdAddrPort(netip.AddrPortFrom(v4, 443))) {
+		t.Fatal("DNSDialer did not resolve through the supplied bootstrap resolver")
+	}
+}
