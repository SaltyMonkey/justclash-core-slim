+// The peer only records the SOCKS request; no DNS server or network port is needed.
+func socksLocalPeer(t *testing.T, payload ...[]byte) (net.Conn, <-chan socks5.Addr) {
+	t.Helper()
+	return socksLocalChainPeer(t, 1, payload...)
+}
+
+func socksLocalChainPeer(t *testing.T, hops int, payload ...[]byte) (net.Conn, <-chan socks5.Addr) {
+	t.Helper()
+	client, server := net.Pipe()
+	client.SetDeadline(time.Now().Add(3 * time.Second))
+	server.SetDeadline(time.Now().Add(3 * time.Second))
+	result := make(chan socks5.Addr, hops)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		defer server.Close()
+		defer close(result)
+		for hop := 0; hop < hops; hop++ {
+			var header [3]byte
+			if _, err := io.ReadFull(server, header[:]); err != nil || !bytes.Equal(header[:], []byte{5, 1, 0}) {
+				return
+			}
+			if _, err := server.Write([]byte{5, 0}); err != nil {
+				return
+			}
+			if _, err := io.ReadFull(server, header[:]); err != nil || header[1] != socks5.CmdConnect {
+				return
+			}
+			addr, err := socks5.ReadAddr0(server)
+			if err != nil {
+				return
+			}
+			if _, err := server.Write([]byte{5, 0, 0, socks5.AtypIPv4, 0, 0, 0, 0, 0, 0}); err != nil {
+				return
+			}
+			result <- addr
+		}
+		if len(payload) > 0 {
+			data := make([]byte, len(payload[0]))
+			if _, err := io.ReadFull(server, data); err != nil || !bytes.Equal(data, payload[0]) {
+				t.Error("SOCKS changed the forwarded application bytes")
+				return
+			}
+			server.Write([]byte{1})
+		}
+	}()
+	t.Cleanup(func() {
+		client.Close()
+		server.Close()
+		select {
+		case <-done:
+		case <-time.After(3 * time.Second):
+			t.Error("SOCKS test peer did not stop")
+		}
+	})
+	return client, result
+}
