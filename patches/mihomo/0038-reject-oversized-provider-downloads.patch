+package resource
+
+import (
+	"io"
+	"math"
+	"net/http"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestProviderDownloadSizeLimit(t *testing.T) {
+	const body = "first\nsecond\n"
+	const cached = "previous\n"
+
+	for _, tc := range []struct {
+		name   string
+		limit  int64
+		reject bool
+	}{
+		{name: "above limit", limit: int64(len(body) - 1), reject: true},
+		{name: "exact limit", limit: int64(len(body))},
+		{name: "below limit", limit: int64(len(body) + 1)},
+		{name: "zero limit"},
+		{name: "negative limit", limit: -1},
+		{name: "largest limit", limit: math.MaxInt64},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fetcher := newTestHTTPFetcher(t, time.Hour, func(w http.ResponseWriter, _ *http.Request) {
+				_, _ = io.WriteString(w, body)
+			})
+			vehicle := fetcher.Vehicle().(*HTTPVehicle)
+			vehicle.sizeLimit = tc.limit
+			if _, _, err := fetcher.SideUpdate([]byte(cached)); err != nil {
+				t.Fatalf("cannot seed provider cache: %T", err)
+			}
+
+			parsed := false
+			fetcher.parser = func(buf []byte) (string, error) {
+				parsed = true
+				return string(buf), nil
+			}
+			got, _, err := fetcher.Update()
+			wantCache := body
+			if tc.reject {
+				if err == nil || !strings.Contains(err.Error(), "exceeds size-limit") {
+					t.Error("expected an oversized response error")
+				}
+				if parsed {
+					t.Error("oversized response reached the parser")
+				}
+				wantCache = cached
+			} else if err != nil || got != body {
+				t.Fatalf("expected the complete body, got %q and error type %T", got, err)
+			}
+
+			data, err := os.ReadFile(vehicle.Path())
+			if err != nil || string(data) != wantCache {
+				t.Fatalf("cache = %q, want %q, error type %T", data, wantCache, err)
+			}
+		})
+	}
+}
