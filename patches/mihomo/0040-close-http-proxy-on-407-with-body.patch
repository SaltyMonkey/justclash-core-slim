Close HTTP proxy connections after a 407 with an unread request body.

An authentication challenge skips consuming the request body. Disable
keep-alive in that case so the next request has a fresh connection.

Related: https://github.com/MetaCubeX/mihomo/issues/3446
Adapted from https://github.com/getmikan/Citrus/pull/85.

diff --git a/listener/http/proxy.go b/listener/http/proxy.go
index 4cc03f4..4f1cc33 100644
--- a/listener/http/proxy.go
+++ b/listener/http/proxy.go
@@ -61,6 +61,10 @@ func HandleConn(c net.Conn, tunnel C.Tunnel, store auth.AuthStore, additions ...
 		resp, user := authenticate(request, authenticator) // always call authenticate function to get user
 		if resp == nil {
 			trusted = true
+		} else if !trusted && resp.StatusCode == http.StatusProxyAuthRequired &&
+			request.Body != nil && request.Body != http.NoBody {
+			// The challenge leaves the body unread, so the stream cannot be reused.
+			keepAlive = false
 		}
 		additions[inUserIdx] = inbound.WithInUser(user)
 
diff --git a/listener/http/proxy_auth_test.go b/listener/http/proxy_auth_test.go
new file mode 100644
index 0000000..09f0dd5
--- /dev/null
+++ b/listener/http/proxy_auth_test.go
@@ -0,0 +1,76 @@
+package http
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	stdhttp "net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/component/auth"
+	listenerAuth "github.com/metacubex/mihomo/listener/auth"
+)
+
+func TestProxyAuthChallengeKeepsAliveOnlyWithoutBody(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		body string
+	}{
+		{name: "unread body", body: "data=example"},
+		{name: "no body"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			request, err := stdhttp.NewRequest(stdhttp.MethodPost, "http://example.invalid/", strings.NewReader(tc.body))
+			if err != nil {
+				t.Fatal(err)
+			}
+			request.Header.Set("Proxy-Connection", "keep-alive")
+			var wire bytes.Buffer
+			if err := request.WriteProxy(&wire); err != nil {
+				t.Fatal(err)
+			}
+
+			client, server := net.Pipe()
+			done := make(chan struct{})
+			store := listenerAuth.NewAuthStore(auth.NewAuthenticator([]auth.AuthUser{{User: "fixture"}}))
+			go func() {
+				defer close(done)
+				HandleConn(server, nil, store)
+			}()
+			t.Cleanup(func() {
+				_ = client.Close()
+				_ = server.Close()
+				<-done
+			})
+			_ = client.SetDeadline(time.Now().Add(5 * time.Second))
+			if _, err := client.Write(wire.Bytes()); err != nil {
+				t.Fatal(err)
+			}
+
+			reader := bufio.NewReader(client)
+			response, err := stdhttp.ReadResponse(reader, request)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer response.Body.Close()
+			if response.StatusCode != stdhttp.StatusProxyAuthRequired {
+				t.Fatalf("status = %d, want 407", response.StatusCode)
+			}
+			wantClose := tc.body != ""
+			if response.Close != wantClose {
+				t.Fatalf("response.Close = %t, want %t", response.Close, wantClose)
+			}
+			if wantClose {
+				if _, err := reader.ReadByte(); !errors.Is(err, io.EOF) {
+					t.Fatalf("expected the inbound to close the connection, got %v", err)
+				}
+			} else if got := response.Header.Get("Proxy-Connection"); got != "keep-alive" {
+				t.Fatalf("Proxy-Connection = %q, want keep-alive", got)
+			}
+		})
+	}
+}
