diff --git a/component/resource/fetcher_retry_interval_test.go b/component/resource/fetcher_retry_interval_test.go
new file mode 100644
index 0000000..028341d
--- /dev/null
+++ b/component/resource/fetcher_retry_interval_test.go
@@ -0,0 +1,97 @@
+package resource
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestProviderHalfIntervalRetryPolicy(t *testing.T) {
+	statuses := []int{http.StatusNotFound, http.StatusGone, http.StatusTooManyRequests}
+	for _, status := range statuses {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			for _, tc := range []struct {
+				name     string
+				interval time.Duration
+				delay    time.Duration
+			}{
+				{name: "even interval", interval: 100 * time.Second, delay: 50 * time.Second},
+				{name: "odd interval", interval: 101 * time.Second, delay: 51 * time.Second},
+				{name: "manual only"},
+			} {
+				t.Run(tc.name, func(t *testing.T) {
+					var requests atomic.Int32
+					fetcher := newTestHTTPFetcher(t, tc.interval, func(w http.ResponseWriter, _ *http.Request) {
+						if requests.Add(1) == 1 {
+							w.Header().Set("Retry-After", "18000")
+							w.WriteHeader(status)
+							return
+						}
+						_, _ = io.WriteString(w, "fresh")
+					})
+					fetcher.backoff.AddAttempt()
+
+					before := time.Now()
+					_, _, err := fetcher.Update()
+					after := time.Now()
+					if err == nil {
+						t.Fatalf("expected an HTTP %d error", status)
+					}
+					if got := fetcher.backoff.Attempt(); got != 0 {
+						t.Fatalf("attempts after HTTP %d = %v, want 0", status, got)
+					}
+
+					wantStatus := fmt.Sprintf("%d %s", status, http.StatusText(status))
+					if tc.interval == 0 {
+						if err.Error() != wantStatus || fetcher.retryUntil.Load() != nil {
+							t.Fatalf("expected HTTP %d without a local deadline", status)
+						}
+						if got, _, err := fetcher.Update(); err != nil || got != "fresh" {
+							t.Fatalf("expected an immediate manual refresh, got %q and error type %T", got, err)
+						}
+						return
+					}
+
+					var retry *providerRetryError
+					if !errors.As(err, &retry) {
+						t.Fatalf("expected a retry deadline, got error type %T", err)
+					}
+					if retry.status != wantStatus {
+						t.Fatalf("retry status = %q, want %q", retry.status, wantStatus)
+					}
+					if retry.until.Before(before.Add(tc.delay)) || retry.until.After(after.Add(tc.delay)) {
+						t.Fatalf("expected the retry deadline %v after the response", tc.delay)
+					}
+					if delay := fetcher.intervalWithRetry(tc.interval); delay <= 0 || delay > tc.delay {
+						t.Fatalf("timer delay = %v, should use the remaining half interval", delay)
+					}
+					if _, _, blocked := fetcher.Update(); blocked != retry {
+						t.Fatalf("expected the same retry deadline, got error type %T", blocked)
+					}
+					if got := requests.Load(); got != 1 {
+						t.Fatalf("requests during cooldown = %d, want 1", got)
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestProviderForbiddenUsesBackoff(t *testing.T) {
+	fetcher := newTestHTTPFetcher(t, 100*time.Second, func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusForbidden)
+	})
+	if _, _, err := fetcher.Update(); err == nil || err.Error() != "403 Forbidden" {
+		t.Fatalf("expected an ordinary HTTP 403 error, got error type %T", err)
+	}
+	if got := fetcher.backoff.Attempt(); got != 1 {
+		t.Fatalf("backoff attempts = %v, want 1", got)
+	}
+	if fetcher.retryUntil.Load() != nil {
+		t.Fatal("HTTP 403 set a half-interval retry deadline")
+	}
+}
