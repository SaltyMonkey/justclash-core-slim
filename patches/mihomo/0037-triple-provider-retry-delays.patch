+package resource
+
+import (
+	"testing"
+	"time"
+)
+
+func TestProviderBackoffTriplesUntilInterval(t *testing.T) {
+	const interval = 5 * time.Minute
+	fetcher := NewFetcher[string](t.Name(), interval, nil, nil, nil, nil)
+	defer fetcher.Close()
+
+	for _, want := range []time.Duration{30 * time.Second, 90 * time.Second, 270 * time.Second, interval, interval} {
+		fetcher.backoff.AddAttempt()
+		attempt := fetcher.backoff.Attempt()
+		if got := fetcher.backoff.ForAttempt(attempt); got != want {
+			t.Fatalf("backoff after %v failures = %v, want %v", attempt, got, want)
+		}
+	}
+}
