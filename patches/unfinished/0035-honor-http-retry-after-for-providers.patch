diff --git a/component/resource/fetcher_retry_after_test.go b/component/resource/fetcher_retry_after_test.go
new file mode 100644
index 0000000..29c7b38
--- /dev/null
+++ b/component/resource/fetcher_retry_after_test.go
@@ -0,0 +1,122 @@
+package resource
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestParseProviderRetryAfter(t *testing.T) {
+	now := time.Date(2026, time.January, 1, 0, 0, 0, 0, time.UTC)
+	until := now.Add(time.Minute)
+
+	for _, tc := range []struct {
+		name  string
+		value string
+		want  time.Time
+	}{
+		{name: "seconds", value: " 60 ", want: until},
+		{name: "HTTP date", value: until.Format(http.TimeFormat), want: until},
+		{name: "zero", value: "0", want: now},
+		{name: "missing"},
+		{name: "invalid", value: "soon"},
+		{name: "negative", value: "-60"},
+		{name: "duration overflow", value: "9223372037"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := parseRetryAfter(tc.value, now); !got.Equal(tc.want) {
+				t.Fatalf("parseRetryAfter(%q) = %v, want %v", tc.value, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestProviderRetryAfterBlocksManualRefresh(t *testing.T) {
+	for _, status := range []int{http.StatusForbidden, http.StatusTooManyRequests, http.StatusServiceUnavailable} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			var requests atomic.Int32
+			fetcher := newTestHTTPFetcher(t, time.Hour, func(w http.ResponseWriter, _ *http.Request) {
+				if requests.Add(1) == 1 {
+					w.Header().Set("Retry-After", "60")
+					w.WriteHeader(status)
+					return
+				}
+				_, _ = io.WriteString(w, "fresh")
+			})
+
+			before := time.Now()
+			_, _, err := fetcher.Update()
+			var retry *retryAfterError
+			if !errors.As(err, &retry) {
+				t.Fatalf("expected a retry deadline, got error type %T", err)
+			}
+			if retry.until.Before(before.Add(time.Minute)) || retry.until.After(time.Now().Add(time.Minute)) {
+				t.Fatal("retry deadline should be 60 seconds after the response")
+			}
+
+			if _, _, blocked := fetcher.Update(); blocked != retry {
+				t.Fatalf("expected the same retry deadline, got error type %T", blocked)
+			}
+			if got := requests.Load(); got != 1 {
+				t.Fatalf("requests during cooldown = %d, want 1", got)
+			}
+			if got := fetcher.backoff.Attempt(); got != 1 {
+				t.Fatalf("attempts during cooldown = %v, want 1", got)
+			}
+
+			if got := fetcher.intervalWithRetryAfter(time.Second); got <= time.Second {
+				t.Fatalf("timer delay = %v, should wait for the server deadline", got)
+			}
+			if got := fetcher.intervalWithRetryAfter(time.Hour); got != time.Hour {
+				t.Fatalf("timer delay = %v, should preserve a longer local backoff", got)
+			}
+
+			fetcher.retryAfter.Store(&retryAfterError{status: retry.status, until: before.Add(-time.Second)})
+			if got, _, err := fetcher.Update(); err != nil || got != "fresh" {
+				t.Fatalf("expected a refresh after expiry, got %q and error type %T", got, err)
+			}
+			if got := requests.Load(); got != 2 {
+				t.Fatalf("requests after expiry = %d, want 2", got)
+			}
+		})
+	}
+}
+
+func TestProviderRetryAfterFallsBackToBackoff(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status int
+		value  string
+	}{
+		{name: "403 without header", status: http.StatusForbidden},
+		{name: "429 without header", status: http.StatusTooManyRequests},
+		{name: "429 with invalid header", status: http.StatusTooManyRequests, value: "invalid"},
+		{name: "429 with zero delay", status: http.StatusTooManyRequests, value: "0"},
+		{name: "429 with past date", status: http.StatusTooManyRequests, value: "Thu, 01 Jan 1970 00:00:00 GMT"},
+		{name: "503 without header", status: http.StatusServiceUnavailable},
+		{name: "502 with valid header", status: http.StatusBadGateway, value: "60"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fetcher := newTestHTTPFetcher(t, time.Hour, func(w http.ResponseWriter, _ *http.Request) {
+				if tc.value != "" {
+					w.Header().Set("Retry-After", tc.value)
+				}
+				w.WriteHeader(tc.status)
+			})
+
+			_, _, err := fetcher.Update()
+			if err == nil {
+				t.Fatalf("expected an HTTP %d error", tc.status)
+			}
+			if retry := fetcher.retryAfter.Load(); retry != nil {
+				t.Fatal("unexpected Retry-After cooldown")
+			}
+			if got := fetcher.backoff.Attempt(); got != 1 {
+				t.Fatalf("attempts after HTTP %d = %v, want 1", tc.status, got)
+			}
+		})
+	}
+}
