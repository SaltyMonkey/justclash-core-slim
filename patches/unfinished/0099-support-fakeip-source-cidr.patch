+package context
+
+import (
+	"context"
+	"net/netip"
+)
+
+type dnsContextWithSource struct {
+	context.Context
+	dns    DNSContext
+	source netip.Addr
+}
+
+// NewDNSContextFrom attaches a client address to a DNS request.
+func NewDNSContextFrom(ctx context.Context, source netip.Addr) *DNSContext {
+	if !source.IsValid() {
+		return NewDNSContext(ctx)
+	}
+	request := &dnsContextWithSource{Context: ctx, source: source}
+	request.dns = *NewDNSContext(request)
+	return &request.dns
+}
+
+// SourceIP returns an invalid address for requests without a client address.
+func (c *DNSContext) SourceIP() netip.Addr {
+	if request, ok := c.Context.(*dnsContextWithSource); ok {
+		return request.source
+	}
+	return netip.Addr{}
+}
