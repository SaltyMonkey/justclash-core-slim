@@ -0,0 +1,41 @@
+package resolver
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"time"
+
+	D "github.com/miekg/dns"
+)
+
+// SourceService can evaluate DNS rules that depend on the client address.
+type SourceService interface {
+	Service
+	NeedsSourceIP() bool
+	ServeMsgFrom(ctx context.Context, msg *D.Msg, source netip.Addr) (*D.Msg, error)
+}
+
+// ServeMsgFrom loads the current DNS service for each query, including during reload.
+func ServeMsgFrom(ctx context.Context, msg *D.Msg, source netip.Addr) (*D.Msg, error) {
+	if server := defaultService.Load(); server != nil {
+		if source.IsValid() {
+			if service, ok := server.(SourceService); ok && service.NeedsSourceIP() {
+				return service.ServeMsgFrom(ctx, msg, source)
+			}
+		}
+		return server.ServeMsg(ctx, msg)
+	}
+
+	return nil, ErrIPNotFound
+}
+
+// RelayDnsConnFrom relays a DNS connection from a known client address.
+func RelayDnsConnFrom(ctx context.Context, conn net.Conn, readTimeout time.Duration, source netip.Addr) error {
+	return relayDnsConn(ctx, conn, readTimeout, source)
+}
+
+// RelayDnsPacketFrom relays a DNS datagram from a known client address.
+func RelayDnsPacketFrom(ctx context.Context, payload []byte, target []byte, source netip.Addr) ([]byte, error) {
+	return relayDnsPacket(ctx, payload, target, SafeDnsPacketSize, source)
+}
