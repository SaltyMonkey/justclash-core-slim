@@ -0,0 +1,56 @@
+package dns
+
+import (
+	"context"
+	"net"
+	"net/netip"
+
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+	D "github.com/miekg/dns"
+)
+
+func (s *Server) serveMsg(w D.ResponseWriter, r *D.Msg) (*D.Msg, error) {
+	service := s.service.Load()
+	if service == nil {
+		return nil, resolver.ErrIPNotFound
+	}
+	ctx := context.Background()
+	if sourceService, ok := service.(resolver.SourceService); ok && sourceService.NeedsSourceIP() {
+		return sourceService.ServeMsgFrom(ctx, r, dnsSourceIP(w.RemoteAddr()))
+	}
+	return service.ServeMsg(ctx, r)
+}
+
+func dnsSourceIP(addr net.Addr) netip.Addr {
+	switch addr := addr.(type) {
+	case *net.UDPAddr:
+		return addr.AddrPort().Addr()
+	case *net.TCPAddr:
+		return addr.AddrPort().Addr()
+	case nil:
+		return netip.Addr{}
+	default:
+		addrPort, err := netip.ParseAddrPort(addr.String())
+		if err == nil {
+			return addrPort.Addr()
+		}
+		return netip.Addr{}
+	}
+}
+
+// NeedsSourceIP reports whether the current FakeIP rules use the client address.
+func (s *Service) NeedsSourceIP() bool {
+	return s.needsSourceIP
+}
+
+func fakeIPNeedsSource(mapper *ResolverEnhancer) bool {
+	if mapper != nil && mapper.FakeIPEnabled() && mapper.fakeIPSkipper != nil {
+		for _, rule := range mapper.fakeIPSkipper.Rules {
+			if rule.RuleType() == C.SrcIPCIDR {
+				return true
+			}
+		}
+	}
+	return false
+}
