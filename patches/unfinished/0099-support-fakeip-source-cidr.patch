@@ -0,0 +1,35 @@
+package fakeip
+
+import (
+	"net/netip"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+// ShouldSkippedFrom evaluates direct source rules with the DNS client address.
+func (p *Skipper) ShouldSkippedFrom(domain string, source netip.Addr) bool {
+	if !source.IsValid() || len(p.Rules) == 0 {
+		return p.ShouldSkipped(domain)
+	}
+	return p.shouldSkipRule(domain, source)
+}
+
+func (p *Skipper) shouldSkipRule(domain string, source netip.Addr) bool {
+	metadata := &C.Metadata{Host: domain}
+	hasSource := source.IsValid()
+	for _, rule := range p.Rules {
+		// Preserve domain-only metadata for classical rule providers.
+		matchSource := hasSource && rule.RuleType() == C.SrcIPCIDR
+		if matchSource {
+			metadata.SrcIP = source
+		}
+		matched, action := rule.Match(metadata, C.RuleMatchHelper{})
+		if matched {
+			return action == UseRealIP
+		}
+		if matchSource {
+			metadata.SrcIP = netip.Addr{}
+		}
+	}
+	return false
+}
