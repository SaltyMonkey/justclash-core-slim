+++ b/rules/provider/mrs_reader.go
@@ -9,6 +9,8 @@
 
 	"github.com/klauspost/compress/zstd"
 )
+
+const maxMrsExtraLength = 1 << 20
 
 var MrsMagicBytes = [4]byte{'M', 'R', 'S', 1} // MRSv1
 
@@ -53,12 +55,12 @@
 		if err != nil {
 			return nil, err
 		}
-		if length < 0 {
+		if length < 0 || length > maxMrsExtraLength {
 			return nil, errors.New("length is invalid")
 		}
 		if length > 0 {
-			extra := make([]byte, length)
-			_, err = io.ReadFull(reader, extra)
+			// Reserved bytes do not need their own souvenir buffer.
+			_, err = io.CopyN(io.Discard, reader, length)
 			if err != nil {
 				return nil, err
 			}
