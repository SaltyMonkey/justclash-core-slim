diff --git a/constant/disabled_protocol.go b/constant/disabled_protocol.go
new file mode 100644
--- /dev/null
+++ b/constant/disabled_protocol.go
@@ -0,0 +1,7 @@
+package constant
+
+// DisabledProtocolError marks a protocol excluded from this build.
+// Providers can skip it without treating every typo as a disabled feature.
+type DisabledProtocolError string
+
+func (e DisabledProtocolError) Error() string { return string(e) }
diff --git a/adapter/provider/disabled_protocol_test.go b/adapter/provider/disabled_protocol_test.go
new file mode 100644
--- /dev/null
+++ b/adapter/provider/disabled_protocol_test.go
@@ -0,0 +1,82 @@
+//go:build no_hysteria1
+
+package provider
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/common/yaml"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestProviderDisabledProtocol(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		nodes     []map[string]any
+		want      []string
+		wantError bool
+	}{
+		{
+			name: "mixed",
+			nodes: []map[string]any{
+				{"name": "first", "type": "direct"},
+				{"name": "disabled", "type": "hysteria", "server": "", "up": "", "down": ""},
+				{"name": "last", "type": "direct"},
+			},
+			want: []string{"first", "last"},
+		},
+		{name: "all-disabled", nodes: []map[string]any{{"name": "disabled", "type": "hysteria", "server": "", "up": "", "down": ""}}, wantError: true},
+		{
+			name: "ordinary-error-is-fatal",
+			nodes: []map[string]any{
+				{"name": "first", "type": "direct"},
+				{"name": "bad", "type": "unknown-test-protocol"},
+			},
+			wantError: true,
+		},
+		{
+			name:      "decode-error-is-fatal",
+			nodes:     []map[string]any{{"name": "bad", "type": "socks5", "server": "", "port": map[string]any{"invalid": true}}},
+			wantError: true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			parse, err := NewProxiesParser(t.Name(), nil, "", "", "", "", overrideSchema{}, "")
+			if err != nil {
+				t.Fatal("provider parser construction failed")
+			}
+			buf, err := yaml.Marshal(ProxySchema{Proxies: tc.nodes})
+			if err != nil {
+				t.Fatal("test payload encoding failed")
+			}
+			proxies, err := parse(buf)
+			for _, proxy := range proxies {
+				defer proxy.Close()
+			}
+			if (err != nil) != tc.wantError {
+				t.Fatal("unexpected provider error policy")
+			}
+			if tc.wantError {
+				return
+			}
+			if len(proxies) != len(tc.want) {
+				t.Fatal("wrong number of retained proxies")
+			}
+			for i, name := range tc.want {
+				if proxies[i].Name() != name {
+					t.Fatal("valid proxy order changed")
+				}
+			}
+		})
+	}
+}
+
+func TestDisabledProtocolStillFailsOutsideProvider(t *testing.T) {
+	proxy, err := adapter.ParseProxy(map[string]any{"name": t.Name(), "type": "hysteria", "server": "", "up": "", "down": ""})
+	var disabled C.DisabledProtocolError
+	if proxy != nil || !errors.As(err, &disabled) {
+		t.Fatal("explicit disabled proxy configuration must remain an error")
+	}
+}
